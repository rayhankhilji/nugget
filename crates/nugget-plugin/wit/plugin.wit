/// The Nugget plugin world: community connectors and read-only agent tools as WebAssembly
/// components.
///
/// A plugin sees the host only through the imports below, and the host checks each call against
/// the capabilities declared in the plugin's `nugget-plugin.toml` and approved by the user.
/// Nothing else is linked. There is no filesystem, no sockets, no environment and no clock beyond
/// `clock.now`. A WASI import that a toolchain adds anyway is linked to a function that traps.
package nugget:plugin@0.1.0;

/// Types shared by imports and exports.
interface types {
    /// Why a call failed. The host maps these onto Nugget's error kinds.
    variant plugin-error {
        /// Bad input or settings.
        invalid(string),
        /// A credential is missing or was rejected.
        unauthorized(string),
        /// A network failure, or a 5xx from the remote.
        network(string),
        /// The remote asked to back off. The payload is the hint, in milliseconds.
        rate-limited(option<u64>),
        not-found(string),
        /// The host denied a capability the plugin did not declare, or one the user did not
        /// approve.
        denied(string),
        /// The sync or call was cancelled. Return promptly.
        cancelled,
        other(string),
    }

    /// The raw content of a document. The pipeline extracts text according to `document.mime`.
    variant content {
        text(string),
        bytes(list<u8>),
    }

    /// One document reported by a connector.
    record document {
        /// Stable key within the source, such as a feed entry id. 1 to 1024 bytes.
        key: string,
        title: option<string>,
        /// MIME type of `content`, such as `text/html` or `text/markdown`.
        mime: string,
        content: content,
        /// Cheap change token, such as an etag or an updated timestamp.
        version: option<string>,
        /// Milliseconds since the Unix epoch.
        modified-at: option<s64>,
        /// Where the user can open the original.
        url: option<string>,
        /// Source-specific metadata, as a JSON object. An empty string means `{}`.
        metadata: string,
    }
}

/// Host-mediated HTTP. The host meters every exchange to the egress ledger. It allows only the
/// hosts the manifest declares, never follows redirects (a 3xx is returned as-is), and caps the
/// response size.
interface http {
    use types.{plugin-error};

    record request {
        /// `GET`, `HEAD`, `POST`, `PUT`, `PATCH` or `DELETE`. Tools may use only `GET` and `HEAD`.
        method: string,
        /// An absolute `https://` URL (or `http://` when the manifest declares the host with
        /// that scheme).
        url: string,
        /// Request headers. The host refuses hop-by-hop headers and the `host` header.
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// Fails with `denied` when the host is not declared, and with `invalid` when the response is
    /// larger than the host allows.
    send: func(req: request) -> result<response, plugin-error>;
}

/// A small key-value store scoped to this plugin (and, for connectors, to one source). The
/// manifest declares its maximum size. Tools may only read.
interface kv {
    use types.{plugin-error};

    get: func(key: string) -> result<option<list<u8>>, plugin-error>;
    set: func(key: string, value: list<u8>) -> result<_, plugin-error>;
    delete: func(key: string) -> result<_, plugin-error>;
    /// Every key that starts with `prefix`, in order.
    keys: func(prefix: string) -> result<list<string>, plugin-error>;
}

/// The plugin's own credentials in the OS keychain. Only the secret names the manifest declares
/// are reachable.
interface secrets {
    use types.{plugin-error};

    get: func(name: string) -> result<option<string>, plugin-error>;
    set: func(name: string, value: string) -> result<_, plugin-error>;
}

/// Logging into Nugget's log, tagged with the plugin id. Long or very frequent messages are
/// truncated or dropped.
interface log {
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    log: func(level: level, message: string);
}

/// The wall clock. This is the only clock a plugin has.
interface clock {
    /// Milliseconds since the Unix epoch.
    now: func() -> s64;
}

/// Where a connector sends its changes during `connector.sync`. These calls fail with `denied`
/// outside a sync.
interface sink {
    use types.{document, plugin-error};

    /// What the store already holds for this source.
    record known-item {
        key: string,
        version: option<string>,
    }

    /// Queue an insert or update. Waits while the pipeline is busy.
    upsert: func(doc: document) -> result<_, plugin-error>;
    /// Queue a delete by key.
    delete: func(key: string) -> result<_, plugin-error>;
    /// Commit `cursor` (JSON) once every change sent before it has been applied.
    checkpoint: func(cursor: string) -> result<_, plugin-error>;
    /// The items the store holds for this source, for a reconciling full pass.
    known-items: func() -> result<list<known-item>, plugin-error>;
    /// Whether the host asked this sync to stop. Return `plugin-error::cancelled` soon after.
    cancelled: func() -> bool;
}

/// A connector: one configured source feeding the ingest pipeline.
interface connector {
    use types.{plugin-error};

    /// Reject bad settings (JSON) before the source is saved. No network access here.
    validate: func(settings: string) -> result<_, plugin-error>;

    /// Run one sync pass. `cursor` is the JSON the previous pass returned, or none for a
    /// reconciling full pass. Returns the cursor (JSON) to resume from next time.
    sync: func(settings: string, cursor: option<string>) -> result<string, plugin-error>;
}

/// Read-only tools for the agent.
interface tools {
    use types.{plugin-error};

    record tool-spec {
        /// `[a-z0-9_]`, 1 to 64 characters, unique within the plugin.
        name: string,
        description: string,
        /// JSON Schema of the input object.
        input-schema: string,
    }

    list-tools: func() -> list<tool-spec>;

    /// Call a tool with a JSON input. Returns a JSON result.
    call: func(name: string, input: string) -> result<string, plugin-error>;
}

world plugin {
    import http;
    import kv;
    import secrets;
    import log;
    import clock;
    import sink;

    export connector;
    export tools;
}
