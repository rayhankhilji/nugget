{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nugget",
  "version": "0.0.1",
  "identifier": "dev.nugget.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nugget",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first personal AI",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nugget contributors",
    "copyright": "Copyright Nugget contributors. Licensed under Apache-2.0.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/rayhankhilji/nugget",
    "longDescription": "Nugget is a local-first personal AI. A background service (nuggetd) keeps your knowledge on this device; the desktop app talks to it over local IPC.",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [],
        "files": {
          "/usr/share/applications/dev.nugget.Nugget.desktop": "../../../packaging/linux/dev.nugget.Nugget.desktop"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/applications/dev.nugget.Nugget.desktop": "../../../packaging/linux/dev.nugget.Nugget.desktop"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {}
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../../packaging/windows/installer-hooks.nsh"
      },
      "wix": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
