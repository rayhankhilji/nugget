{
  "name": "nugget-desktop",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:flows": "vitest run tests",
    "e2e": "node e2e/run.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "d3-force": "3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/d3-force": "3.0.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
