[
  {
    "id": "gg3-mail-reply-kai",
    "instruction": "Reply to Kai and tell him Tuesday works.",
    "apps": [
      "mail"
    ],
    "difficulty": "easy",
    "start": {
      "mail": {
        "inbox": [
          {
            "id": "k1",
            "from": "kai@ourco.example",
            "from_name": "Kai Moreno",
            "subject": "Design review slot",
            "body": "Hi Alex, does Tuesday 11:00 still work for the design review? Kai"
          },
          {
            "id": "m1",
            "from": "priya@ourco.example",
            "from_name": "Priya Shah",
            "subject": "Lunch Thursday?",
            "body": "Hi Alex, are you free for lunch on Thursday at 12:30? Priya"
          },
          {
            "id": "m2",
            "from": "billing@acme.example",
            "from_name": "Acme Billing",
            "subject": "Invoice INV-2291",
            "body": "Your invoice INV-2291 for $1,240.00 is attached. Due 30 November."
          }
        ]
      }
    },
    "expect": {
      "outcome": "done",
      "state": [
        {
          "path": "/mail/sent",
          "op": "len",
          "value": 1
        },
        {
          "path": "/mail/sent",
          "op": "any_like",
          "value": {
            "to": [
              "kai@ourco.example"
            ],
            "in_reply_to": "k1"
          }
        }
      ]
    },
    "reference": [
      {
        "click": "mail.open.k1"
      },
      {
        "click": "mail.reply"
      },
      {
        "type": [
          "mail.compose.body",
          "Thanks Kai, Tuesday works."
        ]
      },
      {
        "confirm": "mail.send"
      },
      {
        "click": "mail.send"
      },
      {
        "finish": "done"
      }
    ]
  },
