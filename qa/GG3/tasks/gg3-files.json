[
  {
    "id": "gg3-files-photos-to-pictures",
    "instruction": "Move both photos out of the Photos folder into Pictures.",
    "apps": [
      "files"
    ],
    "expect": {
      "outcome": "done",
      "state": [
        {
          "path": "/files/entries",
          "op": "any_like",
          "value": {
            "path": "/Pictures/wedding.jpg"
          }
        },
        {
          "path": "/files/entries",
          "op": "any_like",
          "value": {
            "path": "/Pictures/family-2025.jpg"
          }
        },
        {
          "path": "/files/trash",
          "op": "len",
          "value": 0
        }
      ]
    },
    "reference": [
      {
        "click": "files.item.photos"
      },
      {
        "click": "files.open"
      },
      {
        "type": [
          "files.dest",
          "/Pictures"
        ]
      },
      {
        "click": "files.item.family_2025_jpg"
      },
      {
        "click": "files.move"
      },
      {
        "click": "files.item.wedding_jpg"
      },
      {
        "click": "files.move"
      },
      {
        "finish": "done"
      }
    ],
    "difficulty": "medium"
  },
