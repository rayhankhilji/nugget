{
  "manifest_version": 3,
  "name": "Nugget",
  "short_name": "Nugget",
  "version": "0.0.1",
  "description": "Lets your local Nugget assistant read and act on sites you allow, with a visible stop button.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Nugget",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
