---
/**
 * The pricing row: Free (open source) plus the Heed Cloud plans from GET /v1/billing/plans.
 * One flat row with no boxes: tiers are separated by whitespace and hairlines. Each tier has its
 * name in mono caps, a huge Fraunces price, one line on who it's for, one CTA and a short feature list.
 */
import { loadPlans, FREE_TIER, GITHUB_URL } from "../lib/plans";

interface Props {
  /** Heading level for tier names, so the page outline stays in order. */
  level?: "h2" | "h3";
}
const { level = "h3" } = Astro.props;
const H = level;
const { plans, source } = await loadPlans();
const TRIAL_DAYS = plans[0]?.trial_days ?? 14;
const first = plans[0];
const save = first ? Math.round((1 - first.annual_gbp / (first.monthly_gbp * 12)) * 100) : 0;
const gbp = (n: number) => `£${Number.isInteger(n) ? n : n.toFixed(2)}`;
---
<div class="pricing" data-plans-source={source}>
  <fieldset class="toggle">
    <legend class="sr-only">Billing period for Heed Cloud</legend>
    <label><input type="radio" name="interval" value="month" checked /><span>Monthly</span></label>
    <label><input type="radio" name="interval" value="year" /><span>Annual <em>Save {save}%</em></span></label>
  </fieldset>

  <div class="row" style={`--n:${plans.length + 1}`}>
    <article class="tier plan" data-tier="free" aria-labelledby="tier-free">
      <H id="tier-free" class="tname">{FREE_TIER.name} <span class="tag">Open source</span></H>
      <p class="price"><span class="amt-free">£0</span><span class="per">forever</span></p>
      <p class="who">{FREE_TIER.who}</p>
      <div class="ctas">
        <a class="btn btn-secondary" href="/download">Download</a>
        <a class="gh" href={GITHUB_URL} rel="noopener">View on GitHub →</a>
      </div>
      <ul class="feats">{FREE_TIER.features.map((f) => <li>{f}</li>)}</ul>
    </article>

    {
      plans.map((p) => (
        <article class:list={["tier", "plan", { hl: p.highlight }]} data-tier={p.id} aria-labelledby={`tier-${p.id}`}>
          <H id={`tier-${p.id}`} class="tname">
            {p.name}
            {p.highlight && <span class="tag">Most capable</span>}
          </H>
          <p class="price">
            <span class="amt m">{gbp(p.monthly_gbp)}</span>
            <span class="amt y">{gbp(p.annual_gbp)}</span>
            <span class="per m">a month</span>
            <span class="per y">a year</span>
          </p>
          <p class="who">{p.pitch}</p>
          <div class="ctas">
            <a class:list={["btn", "go", "m", p.highlight ? "btn-primary" : "btn-secondary"]} href={`/checkout?plan=${p.id}&interval=month`}>
              Start {TRIAL_DAYS}-day free trial
            </a>
            <a class:list={["btn", "go", "y", p.highlight ? "btn-primary" : "btn-secondary"]} href={`/checkout?plan=${p.id}&interval=year`}>
              Start {TRIAL_DAYS}-day free trial
            </a>
          </div>
          <ul class="feats">{p.features.map((f) => <li>{f}</li>)}</ul>
        </article>
      ))
    }
  </div>
  <p class="fine">
    Heed Cloud prices include VAT. Both cloud plans start with a {TRIAL_DAYS}-day free trial: a card is needed, and you can
    cancel any time before you're charged. The free app is open source under Apache-2.0.
  </p>
</div>

<style>
  .pricing {
    display: grid;
    gap: 32px;
  }
  .toggle {
    justify-self: center;
    display: inline-flex;
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .toggle label {
    position: relative;
    cursor: pointer;
  }
  .toggle input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .toggle span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    transition:
      background-color var(--t-ui),
      color var(--t-ui);
  }
  .toggle em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-2);
  }
  .toggle input:checked + span {
    background: var(--text);
    color: var(--bg);
  }
  .toggle input:checked + span em {
    color: var(--bg);
  }
  .toggle input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The row: hairline above, dashed hairlines between tiers, no boxes. */
  .row {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    border-top: 1px solid var(--text);
  }
  .tier {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px clamp(20px, 2.6vw, 36px) 8px;
  }
  .tier:first-child {
    padding-left: 0;
  }
  .tier:last-child {
    padding-right: 0;
  }
  .tier + .tier {
    border-left: 1px dashed var(--line-2);
  }
  .tname {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-variation-settings: normal;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    word-spacing: normal;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .tag {
    padding: 2px 6px;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--text);
    border-radius: 2px;
  }
  .hl .tag {
    color: var(--on-accent);
    background: var(--accent);
    box-shadow: none;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 4px 0 0;
  }
  .amt,
  .amt-free {
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: 300;
    font-size: clamp(64px, 7vw, 96px);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .per {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .who {
    min-height: 3em;
    color: var(--text-2);
    font-size: 16px;
    max-width: 26em;
  }
  .hl .who {
    color: var(--text);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .gh {
    font-size: 14px;
    color: var(--text);
    text-underline-offset: 3px;
  }
  .feats {
    list-style: none;
    margin: 10px 0 0;
    padding: 14px 0 0;
    border-top: 1px dashed var(--line-2);
    display: grid;
    gap: 9px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.45;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .feats li {
    display: flex;
    gap: 10px;
  }
  .feats li::before {
    content: "";
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 6px;
    background: var(--brand);
  }
  .fine {
    max-width: 680px;
    font-size: 14px;
    color: var(--text-2);
  }

  /* The toggle switches cloud prices and links: CSS only, no script. */
  .y {
    display: none;
  }
  .pricing:has(input[value="year"]:checked) .m {
    display: none;
  }
  .pricing:has(input[value="year"]:checked) span.y {
    display: inline;
  }
  .pricing:has(input[value="year"]:checked) a.y {
    display: inline-flex;
  }

  @media (max-width: 900px) {
    /* Stacked tiers: keep the billing toggle in reach while scrolling. */
    .toggle {
      position: sticky;
      top: 72px;
      z-index: 5;
      box-shadow:
        inset 0 0 0 1px var(--line-2),
        0 6px 20px -8px rgb(20 17 15 / 0.25);
    }
    .row {
      grid-template-columns: 1fr;
    }
    .tier,
    .tier:first-child,
    .tier:last-child {
      padding: 28px 0 20px;
    }
    .tier + .tier {
      border-left: 0;
      border-top: 1px dashed var(--line-2);
    }
    .who {
      min-height: 0;
    }
  }
</style>
