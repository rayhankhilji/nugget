---
/**
 * The agent-progress pattern: a step list (✓ done, spinner current, muted pending), a thin bar, and
 * optional actions. When the card scrolls into view the steps tick to their final state one at a time
 * (a 180ms check draw). Without JS, or with reduced motion, the final state renders straight away.
 */
import AppIcon from "../AppIcon.astro";

type State = "done" | "current" | "pending";
interface Props {
  title: string;
  meta: string;
  steps: { label: string; detail?: string; state: State; icon?: string }[];
  actions?: { label: string; primary?: boolean }[];
}
const { title, meta, steps, actions = [] } = Astro.props;
const done = steps.filter((s) => s.state === "done").length;
const pct = Math.round(((done + (steps.some((s) => s.state === "current") ? 0.5 : 0)) / steps.length) * 100);
---
<article class="step-card" data-steps style={`--p:${pct}%`}>
  <header>
    <p class="t">{title}</p>
    <p class="m">{meta}</p>
  </header>
  <div class="bar" aria-hidden="true"><i></i></div>
  <ol>
    {
      steps.map((s) => (
        <li data-s={s.state} data-final={s.state}>
          <span class="st" aria-hidden="true">
            <svg class="ck" viewBox="0 0 16 16">
              <path d="M3.5 8.5l3 3 6-7" />
            </svg>
            <span class="sp" />
          </span>
          {s.icon && <AppIcon slug={s.icon} size={16} tile />}
          <span class="lbl">
            {s.label}
            {s.detail && <small>{s.detail}</small>}
          </span>
          <span class="sr-only">{s.state === "done" ? "(done)" : s.state === "current" ? "(in progress)" : "(next)"}</span>
        </li>
      ))
    }
  </ol>
  {
    actions.length > 0 && (
      <footer>
        {actions.map((a) => (
          <span class:list={["btn", "btn-sm", a.primary ? "btn-primary" : "btn-secondary"]}>{a.label}</span>
        ))}
      </footer>
    )
  }
</article>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    document.querySelectorAll<HTMLElement>("[data-steps]").forEach((card) => {
      const items = [...card.querySelectorAll<HTMLElement>("li[data-final]")];
      const finalP = card.style.getPropertyValue("--p");
      items.forEach((li, i) => (li.dataset["s"] = i === 0 ? "current" : "pending"));
      card.style.setProperty("--p", "6%");
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e?.isIntersecting) return;
          io.disconnect();
          let i = 0;
          const tick = () => {
            const li = items[i];
            if (!li) {
              card.style.setProperty("--p", finalP);
              return;
            }
            const f = li.dataset["final"]!;
            li.dataset["s"] = f;
            if (f !== "done") {
              card.style.setProperty("--p", finalP);
              return; // stop at the current step; the rest stay pending
            }
            i += 1;
            const next = items[i];
            if (next && next.dataset["final"] !== "pending") next.dataset["s"] = "current";
            card.style.setProperty("--p", `${Math.round((i / items.length) * 100)}%`);
            setTimeout(tick, 650);
          };
          setTimeout(tick, 500);
        },
        { threshold: 0.6 },
      );
      io.observe(card);
    });
  }
</script>

<style>
  .step-card {
    width: 100%;
    padding: 18px;
    border-radius: var(--heed-radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    font-size: 14px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .t {
    font-weight: 600;
  }
  .m {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    white-space: nowrap;
  }
  .bar {
    height: 3px;
    margin: 12px 0 6px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: var(--p);
    background: var(--accent);
    border-radius: 3px;
    transition: width var(--heed-dur-brand) var(--ease);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    transition: color var(--t-ui);
  }
  li:last-child {
    border-bottom: 0;
  }
  li[data-s="pending"] {
    color: var(--text-3);
  }
  li :global(.app) {
    margin-top: 1px;
  }
  li[data-s="pending"] :global(.app) {
    opacity: 0.55;
  }
  .lbl {
    display: grid;
    gap: 1px;
  }
  .lbl small {
    font-size: 12.5px;
    color: var(--text-2);
  }
  li[data-s="pending"] .lbl small {
    color: var(--text-3);
  }
  .st {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line-2);
    transition:
      background-color var(--t-ui),
      box-shadow var(--t-ui);
  }
  .ck {
    position: absolute;
    inset: 2px;
    fill: none;
    stroke: var(--on-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 14;
    stroke-dashoffset: 14;
    transition: stroke-dashoffset 180ms var(--ease) 60ms;
  }
  .sp {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid transparent;
    opacity: 0;
  }
  /* Success is ultramarine, not green. */
  li[data-s="done"] .st {
    background: var(--accent);
    box-shadow: none;
  }
  li[data-s="done"] .ck {
    stroke-dashoffset: 0;
  }
  li[data-s="current"] .sp {
    opacity: 1;
    border-top-color: var(--accent);
    border-right-color: var(--accent);
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li[data-s="current"] .sp {
      animation: none;
      border-left-color: var(--accent);
    }
  }
  footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 12px;
  }
  footer .btn {
    pointer-events: none;
  }
</style>
