---
/**
 * HTML recreation of the v4 Home screen: a light Fraunces greeting with today's focus, brief prose with
 * grey citation chips, then recommended actions. Used until real v4 app screens exist.
 */
import AppIcon from "../AppIcon.astro";
---
<article class="card brief" aria-label="Example: the Home brief in Heed">
  <p class="label">Tuesday 4 November</p>
  <p class="hello">Good morning, Ada.</p>
  <p class="focus"><span>Focus for today</span> the Driftwood API decision</p>
  <p class="prose">
    Ines wants a call on cursor pagination before the 11:00 review <span class="chip"><AppIcon slug="notion" size={11} tile />RFC</span>.
    Margaret is still waiting on a kickoff time <span class="chip"><AppIcon slug="gmail" size={11} tile />Mail</span>.
  </p>
  <ul class="actions">
    <li><span class="k">1</span>Prep for the Driftwood review<span class="t">11:00</span></li>
    <li><span class="k">2</span>Reply to Margaret with Thursday 2pm<span class="t">draft ready</span></li>
    <li><span class="k">3</span>Skim 3 edits to the board notes<span class="t">4 min</span></li>
  </ul>
</article>

<style>
  .brief {
    width: 340px;
    max-width: 100%;
    padding: 18px 18px 12px;
    border-radius: var(--heed-radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    font-size: 13.5px;
  }
  .label {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
  }
  .hello {
    margin: 4px 0 2px;
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: var(--heed-display-weight);
    font-size: 28px;
    letter-spacing: var(--heed-display-tracking);
    line-height: 1.1;
  }
  .focus {
    font-size: 13px;
    color: var(--text);
  }
  .focus span {
    color: var(--text-3);
    margin-right: 4px;
  }
  .prose {
    margin: 12px 0;
    color: var(--text-2);
    line-height: 1.6;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px 0 3px;
    border-radius: 999px;
    font-size: 11px;
    line-height: 18px;
    color: var(--text-2);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    vertical-align: 0.05em;
  }
  .actions {
    list-style: none;
    margin: 0 -6px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .actions li {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 9px 6px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }
  .actions li:last-child {
    border-bottom: 0;
  }
  .actions li:first-child {
    background: var(--accent-soft);
    border-radius: 8px;
  }
  .k {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .t {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
  }
</style>
