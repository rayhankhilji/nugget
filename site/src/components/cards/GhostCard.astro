---
/**
 * Ghost text in an email: Heed's suggestion appears after the caret, Tab accepts it.
 * Pure HTML/CSS with a small script that loops the typing. Without JS, or with reduced motion,
 * it shows the accepted state.
 */
import AppIcon from "../AppIcon.astro";
const typed = "Thursday ";
const ghost = "at 2pm works. I've moved the review to Friday so we get the full hour.";
---
<article class="card ghostcard" data-ghost aria-label="Example: Heed suggesting the rest of an email as ghost text">
  <header>
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="t">New message</span>
  </header>
  <dl>
    <div><dt>To</dt><dd>Margaret Osei</dd></div>
    <div><dt>Subject</dt><dd>Re: Moorland kickoff</dd></div>
  </dl>
  <p class="hi">Hi Margaret,</p>
  <p class="line"><span class="typed">{typed}</span><span class="caret" aria-hidden="true"></span><span class="ghost" data-state="accepted">{ghost}</span><span class="chip" data-state="accepted"><span class="c-tab"><i aria-hidden="true"></i><kbd>Tab</kbd></span><span class="c-src"><AppIcon slug="googlecalendar" size={12} tile />2 sources</span></span></p>
  <script type="application/json" set:html={JSON.stringify({ typed, ghost })} />
</article>

<script>
  const root = document.querySelector<HTMLElement>("[data-ghost]");
  if (root && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const { typed: T, ghost: G } = JSON.parse(root.querySelector("script")?.textContent ?? "{}") as { typed: string; ghost: string };
    const typed = root.querySelector<HTMLElement>(".typed")!;
    const ghost = root.querySelector<HTMLElement>(".ghost")!;
    const chip = root.querySelector<HTMLElement>(".chip")!;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    let visible = false;
    new IntersectionObserver(([e]) => (visible = !!e?.isIntersecting)).observe(root);
    const ready = async () => {
      while (!visible || document.hidden) await wait(300);
    };
    (async () => {
      await wait(1200);
      for (;;) {
        await ready();
        typed.textContent = "";
        ghost.textContent = "";
        ghost.dataset["state"] = chip.dataset["state"] = "idle";
        await wait(400);
        for (const ch of T) {
          await ready();
          typed.textContent += ch;
          await wait(70 + Math.random() * 60);
        }
        await wait(300);
        ghost.dataset["state"] = "streaming";
        for (const [i, w] of G.split(/(?<= )/).entries()) {
          const s = document.createElement("span");
          s.className = "w";
          s.textContent = w;
          ghost.append(s);
          if (i === 1) chip.dataset["state"] = "suggesting";
          await wait(45 + Math.random() * 40);
        }
        ghost.dataset["state"] = "suggesting";
        await wait(1400);
        chip.dataset["state"] = "pressed";
        await wait(180);
        ghost.dataset["state"] = chip.dataset["state"] = "accepted";
        await wait(3600);
      }
    })();
  }
</script>

<style>
  .ghostcard {
    width: 380px;
    max-width: 100%;
    background: var(--surface);
    border-radius: 16px;
    box-shadow: var(--shadow-3);
    overflow: hidden;
    font-size: 14px;
  }
  header {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding: 0 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .t {
    font-size: 12px;
    color: var(--text-3);
  }
  dl {
    margin: 0 16px;
  }
  dl div {
    display: flex;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  dt {
    width: 54px;
    color: var(--text-3);
  }
  dd {
    margin: 0;
  }
  .hi,
  .line {
    margin: 12px 16px 0;
    line-height: 1.55;
    font-size: 14.5px;
  }
  .line {
    margin-bottom: 16px;
    min-height: 4.65em;
  }
  .typed {
    white-space: pre-wrap;
  }
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.1em;
    margin-bottom: -0.2em;
    background: var(--brand);
    animation: blink 1.1s steps(1) infinite;
  }
  .line:has(.ghost[data-state="accepted"]) .caret {
    display: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .ghost {
    color: var(--ghost);
    transition: color 0.5s var(--ease);
    border-radius: 3px;
  }
  .ghost[data-state="idle"] {
    color: transparent;
  }
  .ghost[data-state="streaming"] :global(.w:nth-last-child(-n + 3)) {
    background: linear-gradient(90deg, var(--ghost), var(--brand) 60%, transparent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ghost[data-state="accepted"] {
    color: var(--text);
    animation: wash 2.4s var(--ease) forwards;
  }
  @keyframes wash {
    0% {
      background: var(--accent-soft);
    }
    100% {
      background: transparent;
    }
  }
  .chip {
    display: inline-flex;
    align-items: center;
    vertical-align: 0.05em;
    height: 20px;
    margin-left: 6px;
    padding: 0 7px 0 6px;
    border-radius: 999px;
    font-size: 11px;
    color: var(--text-2);
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line-2);
    white-space: nowrap;
    transition:
      opacity 0.2s,
      transform 0.15s var(--ease);
  }
  .chip[data-state="idle"] {
    opacity: 0;
  }
  .chip[data-state="pressed"] {
    transform: scale(0.92);
  }
  .c-tab,
  .c-src {
    display: none;
    align-items: center;
    gap: 5px;
  }
  .chip[data-state="suggesting"] .c-tab,
  .chip[data-state="pressed"] .c-tab {
    display: inline-flex;
  }
  .chip[data-state="accepted"] .c-src {
    display: inline-flex;
  }
  .c-tab i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }
  .chip kbd {
    height: 15px;
    font-size: 10px;
    vertical-align: 0;
  }
  .chip[data-state="pressed"] kbd {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
