---
/**
 * "How it works" as an agent-progress card: connect → read and learn → draft and ask → you approve.
 * When it scrolls into view, steps tick to a check (180ms draw) one by one and the third spins.
 * Without JS, or with reduced motion, it renders the final state.
 */
import AppIcon from "../AppIcon.astro";

const steps = [
  { title: "Connect your apps", detail: "Gmail, Calendar, Drive and Notion, one click each" },
  { title: "Heed reads and learns", detail: "12,408 emails, events and docs, kept in sync" },
  { title: "It drafts and asks", detail: "Drafting a reply to Margaret about Thursday" },
  { title: "You approve", detail: "Nothing is sent until you say so" },
];
---
<article class="agent" data-agent data-step="2" aria-label="How Heed works, as a progress card">
  <header>
    <div>
      <p class="kicker">Getting Heed ready</p>
      <p class="count"><span data-count>3</span> of 4</p>
    </div>
    <span class="apps" aria-hidden="true">
      <AppIcon slug="gmail" size={22} tile />
      <AppIcon slug="googlecalendar" size={22} tile />
      <AppIcon slug="googledrive" size={22} tile />
      <AppIcon slug="notion" size={22} tile />
    </span>
  </header>
  <div class="bar" aria-hidden="true"><i></i></div>
  <ol>
    {
      steps.map((s, i) => (
        <li data-i={i}>
          <span class="state" aria-hidden="true">
            <svg class="check" viewBox="0 0 16 16">
              <path d="M3.5 8.5l3 3 6-7" />
            </svg>
            <span class="spin" />
          </span>
          <span class="txt">
            <b>{s.title}</b>
            <small>{s.detail}</small>
          </span>
        </li>
      ))
    }
  </ol>
  <footer>
    <span class="btn btn-secondary btn-sm">Pause</span>
    <span class="btn btn-primary btn-sm">View draft</span>
  </footer>
</article>

<script>
  const card = document.querySelector<HTMLElement>("[data-agent]");
  if (card && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const set = (n: number) => {
      card.dataset["step"] = String(n);
      card.querySelector("[data-count]")!.textContent = String(Math.min(n + 1, 4));
    };
    set(0);
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        io.disconnect();
        let n = 0;
        const tick = () => {
          n += 1;
          set(n);
          if (n < 2) setTimeout(tick, 900);
        };
        setTimeout(tick, 700);
      },
      { threshold: 0.5 },
    );
    io.observe(card);
  }
</script>

<style>
  .agent {
    width: 100%;
    max-width: 460px;
    padding: 20px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-3);
    font-size: 14px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }
  .kicker {
    font-weight: 600;
    font-size: 15px;
  }
  .count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    margin-top: 2px;
  }
  .apps {
    display: flex;
  }
  .apps :global(.app + .app) {
    margin-left: -6px;
  }
  .apps :global(.app) {
    box-shadow:
      0 0 0 2px var(--surface),
      0 1px 2px rgb(0 0 0 / 0.1);
  }
  .bar {
    height: 4px;
    border-radius: 4px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    margin-bottom: 8px;
  }
  .bar i {
    display: block;
    height: 100%;
    width: calc((var(--n, 2) + 0.5) * 25%);
    background: var(--accent);
    border-radius: 4px;
    transition: width 600ms var(--ease);
  }
  .agent[data-step="0"] {
    --n: 0;
  }
  .agent[data-step="1"] {
    --n: 1;
  }
  .agent[data-step="2"] {
    --n: 2;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  .txt {
    display: grid;
    gap: 2px;
  }
  .txt b {
    font-weight: 560;
  }
  .txt small {
    color: var(--text-2);
    font-size: 13px;
  }
  .state {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line-2);
    transition: background-color var(--t-ui), box-shadow var(--t-ui);
  }
  .check {
    position: absolute;
    inset: 2px;
    fill: none;
    stroke: var(--on-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 14;
    stroke-dashoffset: 14;
    transition: stroke-dashoffset 180ms var(--ease) 60ms;
  }
  .spin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid transparent;
    border-top-color: var(--accent);
    border-right-color: var(--accent);
    opacity: 0;
  }
  /* done steps: index < step */
  .agent[data-step="1"] li[data-i="0"] .state,
  .agent[data-step="2"] li[data-i="0"] .state,
  .agent[data-step="2"] li[data-i="1"] .state {
    background: var(--accent);
    box-shadow: none;
  }
  .agent[data-step="1"] li[data-i="0"] .check,
  .agent[data-step="2"] li[data-i="0"] .check,
  .agent[data-step="2"] li[data-i="1"] .check {
    stroke-dashoffset: 0;
  }
  /* current step spins */
  .agent[data-step="0"] li[data-i="0"] .spin,
  .agent[data-step="1"] li[data-i="1"] .spin,
  .agent[data-step="2"] li[data-i="2"] .spin {
    opacity: 1;
    animation: spin 0.9s linear infinite;
  }
  /* pending steps are muted */
  .agent[data-step="0"] li[data-i="1"],
  .agent[data-step="0"] li[data-i="2"],
  .agent[data-step="1"] li[data-i="2"],
  li[data-i="3"] {
    color: var(--text-3);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .agent .spin {
      animation: none !important;
      border-color: var(--accent);
      border-left-color: transparent;
    }
  }
  footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 14px;
  }
  footer .btn {
    pointer-events: none;
  }
</style>
