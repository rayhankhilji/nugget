---
/** HTML recreation of a Needs-you approval card: Heed drafted it; nothing is sent until you approve. */
import AppIcon from "../AppIcon.astro";
---
<article class="card approve" aria-label="Example: a Needs you card waiting for approval">
  <header>
    <span class="tag">Needs you</span>
    <span class="why">Waiting 2 days</span>
  </header>
  <p class="title">Reply to Margaret Osei</p>
  <p class="sub"><AppIcon slug="gmail" size={14} tile /> Re: Moorland kickoff</p>
  <blockquote>
    Thursday at 2pm works. I've moved the design review to Friday, so we get the full hour.
  </blockquote>
  <div class="cites">
    <span><AppIcon slug="googlecalendar" size={12} tile />Calendar</span>
    <span><AppIcon slug="gmail" size={12} tile />Thread</span>
  </div>
  <footer>
    <span class="btn btn-primary btn-sm">Approve and send</span>
    <span class="btn btn-secondary btn-sm">Edit</span>
  </footer>
</article>

<style>
  .approve {
    width: 320px;
    max-width: 100%;
    padding: 16px 18px 18px;
    background: var(--surface);
    border-radius: 16px;
    box-shadow: var(--shadow-3);
    font-size: 13.5px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }
  .tag::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }
  .why {
    font-size: 11.5px;
    color: var(--text-3);
  }
  .title {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .sub {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    color: var(--text-2);
    font-size: 12.5px;
  }
  blockquote {
    margin: 12px 0 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text);
    line-height: 1.45;
  }
  .cites {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }
  .cites span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 4px;
    border-radius: 999px;
    font-size: 11.5px;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  footer {
    display: flex;
    gap: 8px;
  }
  footer .btn {
    pointer-events: none;
  }
</style>
