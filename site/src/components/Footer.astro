---
import Logo from "./Logo.astro";
interface Props {
  minimal?: boolean;
  /** The closing "Let Heed keep watch" line; the landing page has its own get-it block instead. */
  cta?: boolean;
}
const { minimal = false, cta = true } = Astro.props;
const year = new Date().getFullYear();
const cols = [
  {
    title: "Product",
    links: [
      ["/#product", "Features"],
      ["/pricing", "Pricing"],
      ["/download", "Download"],
      ["/#faq", "FAQ"],
      ["/docs/self-host", "Self-hosting"],
    ],
  },
  {
    title: "Account",
    links: [
      ["/signup", "Start free trial"],
      ["/signin", "Sign in"],
      ["/account", "Manage account"],
    ],
  },
  {
    title: "Trust",
    links: [
      ["/privacy", "Privacy, in plain English"],
      ["/legal/privacy", "Privacy policy"],
      ["/legal/terms", "Terms of service"],
    ],
  },
];
---
<footer class:list={["ftr", { minimal }]}>
  {
    !minimal && (
      <div class:list={["horizon", { bare: !cta }]}>
        {cta && (
          <div class="wrap horizon-copy">
            <p class="h-line">Let Heed keep watch.</p>
            <p class="h-sub">14-day free trial. A card is needed, and you can cancel any time before you're charged.</p>
            <div class="h-cta">
              <a class="btn btn-primary btn-lg" href="/pricing">Start free trial</a>
              <a class="btn btn-secondary btn-lg" href="/download">Download for Mac</a>
            </div>
          </div>
        )}
        <div class="land" data-bg aria-hidden="true" />
      </div>
    )
  }
  <div class="wrap foot">
    {!minimal && <div class="giant" aria-hidden="true" />}
    {
      !minimal && (
        <div class="top">
          <div class="brand">
            <Logo size={22} />
            <p class="muted">The assistant that pays attention for you. Made in the UK.</p>
          </div>
          {cols.map((c) => (
            <nav aria-label={c.title}>
              <h2>{c.title}</h2>
              <ul>
                {c.links.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      )
    }
    <div class="bottom">
      <p>© {year} Heed. All rights reserved.</p>
      <div class="theme" role="radiogroup" aria-label="Colour theme">
        <button type="button" role="radio" data-theme-set="system" aria-checked="true">Auto</button>
        <button type="button" role="radio" data-theme-set="light" aria-checked="false">Light</button>
        <button type="button" role="radio" data-theme-set="dark" aria-checked="false">Dark</button>
      </div>
    </div>
  </div>
</footer>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-set]");
  const sync = () => {
    const cur = root.dataset["theme"] ?? "system";
    buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset["themeSet"] === cur)));
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const t = b.dataset["themeSet"];
      try {
        if (t === "light" || t === "dark") {
          root.dataset["theme"] = t;
          localStorage.setItem("heed-theme", t);
        } else {
          delete root.dataset["theme"];
          localStorage.removeItem("heed-theme");
        }
      } catch {
        /* storage blocked: the theme still applies for this page */
      }
      sync();
    }),
  );
  sync();
</script>

<style>
  .ftr {
    padding: 0 0 32px;
    font-size: 14px;
  }
  .ftr.minimal {
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .horizon {
    position: relative;
    padding-top: clamp(80px, 11vw, 140px);
    margin-bottom: 56px;
    border-top: 1px solid var(--line);
  }
  .horizon.bare {
    padding-top: 0;
    border-top: 0;
  }
  .horizon-copy {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }
  .h-line {
    font-family: var(--display);
    font-weight: 330;
    font-variation-settings: var(--heed-display-settings);
    font-size: clamp(40px, 7vw, 88px);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .h-sub {
    color: var(--text-2);
    font-size: 17px;
  }
  .h-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  /* The landscape loads once the footer is near (html.js adds .near); without JS it loads straight away. */
  .land {
    height: clamp(180px, 28vw, 380px);
    margin-top: clamp(-40px, -3vw, -16px);
    --bg-img: url("/art/landscape-light.webp");
    background: center bottom / cover no-repeat;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .land {
      --bg-img: url("/art/landscape-dark.webp");
    }
  }
  :global(:root[data-theme="dark"]) .land {
    --bg-img: url("/art/landscape-dark.webp");
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 32px;
    padding-bottom: 48px;
  }
  .brand :global(.logo) {
    font-size: 22px;
  }
  .brand {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  h2 {
    font-family: var(--font);
    font-variation-settings: normal;
    word-spacing: normal;
    line-height: 1.3;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-2);
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .top a {
    color: var(--text-2);
    text-decoration: none;
  }
  .top a:hover {
    color: var(--text);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }
  .bottom:first-child {
    border-top: 0;
    padding-top: 0;
  }
  /* A giant, faint wordmark behind the footer. */
  .foot {
    position: relative;
  }
  .foot > :not(.giant) {
    position: relative;
    z-index: 1;
  }
  .giant {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: -24px;
    z-index: 0;
    color: var(--text);
    opacity: 0.05;
    line-height: 0;
    pointer-events: none;
  }
  .giant {
    aspect-ratio: 178.4 / 78.5;
    background: currentColor;
    -webkit-mask: url("/brand/heed-wordmark-mono.svg") center / contain no-repeat;
    mask: url("/brand/heed-wordmark-mono.svg") center / contain no-repeat;
  }
  .theme {
    display: inline-flex;
    padding: 3px;
    border-radius: 9px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .theme button {
    border: 0;
    background: transparent;
    padding: 4px 10px;
    min-height: 28px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-2);
    cursor: pointer;
  }
  .theme button[aria-checked="true"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-1);
  }
  @media (max-width: 720px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
