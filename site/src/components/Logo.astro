---
/**
 * The Heed logo from DS1's brand assets (docs/brand/assets, copied to public/brand): the ultramarine
 * squircle mark with a cream "h", and the Fraunces wordmark drawn from outlines. The wordmark uses
 * currentColor, so it follows the theme.
 */
import markSvg from "../../public/brand/heed-mark.svg?raw";
import wordSvg from "../../public/brand/heed-wordmark-mono.svg?raw";

interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
const mark = markSvg.replace(/\srole="img"/, "").replace(/\saria-label="[^"]*"/, ' aria-hidden="true"');
const word = wordSvg;
---
<span class="logo" style={`--s:${size}px`}>
  <span class="mark" set:html={mark} />
  <span class="word" set:html={word} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--s) * 0.32);
    color: currentColor;
    line-height: 0;
  }
  .mark,
  .mark :global(svg) {
    width: var(--s);
    height: var(--s);
    flex: none;
  }
  .word :global(svg) {
    height: calc(var(--s) * 0.98);
    width: auto;
    display: block;
  }
</style>
