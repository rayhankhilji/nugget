---
/**
 * The Heed logo from DS1's brand assets (public/brand, copied from docs/brand/assets): the ultramarine
 * squircle mark and the outline wordmark. Both are cached files rather than inline SVG, to keep pages
 * light; the wordmark is a CSS mask filled with currentColor, so it follows the theme.
 */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---
<span class="logo" style={`--s:${size}px`}>
  <img class="mark" src="/brand/heed-mark.svg" alt="" width={size} height={size} />
  <span class="word" role="img" aria-label="heed"></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--s) * 0.32);
    color: currentColor;
    line-height: 0;
  }
  .mark {
    width: var(--s);
    height: var(--s);
    flex: none;
  }
  /* heed-wordmark-mono.svg has a 178.4 x 78.5 viewBox. */
  .word {
    display: block;
    height: calc(var(--s) * 0.98);
    aspect-ratio: 178.4 / 78.5;
    background: currentColor;
    -webkit-mask: url("/brand/heed-wordmark-mono.svg") center / contain no-repeat;
    mask: url("/brand/heed-wordmark-mono.svg") center / contain no-repeat;
  }
</style>
