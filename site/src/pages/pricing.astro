---
import Base from "../layouts/Base.astro";
import PricingCards from "../components/PricingCards.astro";
import { loadPlans, ai, apps, sync, history, type Plan } from "../lib/plans";

const { plans } = await loadPlans();
const [a, b] = plans as [Plan, Plan];
const yes = (v: boolean) => (v ? "Yes" : "No");
const rows: [string, string, string][] = [
  ["AI", ai(a.entitlements), ai(b.entitlements)],
  ["Connected apps", apps(a.entitlements).replace(" connected apps", ""), apps(b.entitlements).replace(" connected apps", "").replace(" apps", "")],
  ["Sync", sync(a.entitlements).replace("Sync every", "Every"), sync(b.entitlements).replace("Sync every", "Every")],
  ["History", history(a.entitlements).replace(" of history", ""), history(b.entitlements).replace(" of history", "").replace("Full history", "Everything")],
  ["Ghost text anywhere on your Mac", yes(a.entitlements.ghost_text), yes(b.entitlements.ghost_text)],
  ["Needs you and the daily brief", yes(a.entitlements.needs_you_inbox && a.entitlements.daily_brief), yes(b.entitlements.needs_you_inbox && b.entitlements.daily_brief)],
  ["Actions with your approval", yes(a.entitlements.actions_with_approval), yes(b.entitlements.actions_with_approval)],
  ["Agent tasks and computer use", yes(a.entitlements.agent_tasks && a.entitlements.computer_use), yes(b.entitlements.agent_tasks && b.entitlements.computer_use)],
  ["Devices", String(a.entitlements.devices), String(b.entitlements.devices)],
  ["Support", a.entitlements.priority_support ? "Priority" : "Standard", b.entitlements.priority_support ? "Priority" : "Standard"],
];
const description = `Heed is £${a.monthly_gbp} a month, or £${b.monthly_gbp} for ${b.name}. Both start with a ${a.trial_days}-day free trial; annual plans get two months free.`;
---
<Base title="Pricing" description={description}>
  <section class="wrap top">
    <p class="eyebrow">Pricing</p>
    <h1>Pay for the hours it gives back.</h1>
    <p class="lede">Two plans, no free tier, no surprises. Try either one free for 14 days.</p>
  </section>
  <section class="wrap" aria-label="Plans">
    <PricingCards level="h2" />
  </section>

  <section class="wrap compare" aria-labelledby="cmp-h">
    <h2 id="cmp-h">Compare plans</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">{a.name}</th><th scope="col">{b.name}</th></tr>
        </thead>
        <tbody>
          {rows.map(([k, a, b]) => (
            <tr>
              <th scope="row">{k}</th>
              <td data-v={a}>{a}</td>
              <td data-v={b}>{b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Fair use applies to AI on both plans: in a very heavy month, answers switch to the fast model before a hard cap is
      reached. Devices count when used in the last 30 days.
    </p>
  </section>
</Base>

<style>
  .top {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
    padding-block: clamp(56px, 8vw, 96px) 40px;
  }
  h1 {
    font-size: clamp(36px, 5.6vw, 64px);
    letter-spacing: -0.045em;
    max-width: 14em;
  }
  .lede {
    color: var(--text-2);
    font-size: 18px;
  }
  .compare {
    max-width: calc(880px + var(--gutter) * 2);
    padding-block: 96px 120px;
  }
  .compare h2 {
    font-size: 28px;
    margin-bottom: 24px;
  }
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--r-4);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    min-width: 480px;
  }
  th,
  td {
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 14px;
    color: var(--text-2);
    font-weight: 500;
  }
  tbody th {
    font-weight: 500;
  }
  td {
    color: var(--text-2);
  }
  td[data-v="No"] {
    color: var(--text-3);
  }
  .note {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-2);
  }
</style>
