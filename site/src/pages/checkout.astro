---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import CloudClosed from "../components/CloudClosed.astro";
import { cloudOpen } from "../lib/config";
---
<Base title="Checkout" description="Start your Heed trial." noindex minimal>
  {
    cloudOpen ? (
      <Panel title="Starting your trial" lede="Taking you to our payment provider, Stripe…">
        <div class="progress" aria-hidden="true" data-progress><i></i></div>
        <p class="status" role="status" aria-live="polite" data-msg hidden></p>
        <p class="small" data-actions hidden><a href="/pricing">Back to pricing</a> · <a href="/account">Your account</a></p>
        <noscript><p class="status err">Checkout needs JavaScript.</p></noscript>
      </Panel>
    ) : (
      <CloudClosed />
    )
  }
</Base>

<script>
  import { currentSession } from "../lib/supabase";
  import { billingCheckout, CloudError } from "../lib/cloud";
  import { isInterval, isPlanId, planName } from "../lib/plans";

  const msg = document.querySelector<HTMLElement>("[data-msg]");
  const fail = (text: string) => {
    if (!msg) return;
    msg.textContent = text;
    msg.classList.add("err");
    msg.hidden = false;
    document.querySelector<HTMLElement>("[data-progress]")!.hidden = true;
    document.querySelector<HTMLElement>("[data-actions]")!.hidden = false;
    document.querySelector("h1")!.textContent = "Checkout didn't start";
    document.querySelector(".lede")?.remove();
  };

  (async () => {
    if (!msg) return; // Heed Cloud isn't configured for this build
    const params = new URLSearchParams(location.search);
    const plan = params.get("plan");
    const interval = params.get("interval") ?? "month";
    if (!isPlanId(plan) || !isInterval(interval)) {
      fail("That plan doesn't exist. Pick one on the pricing page.");
      return;
    }
    const session = await currentSession();
    if (!session) {
      const back = `/checkout?plan=${plan}&interval=${interval}`;
      location.replace(`/signup?next=${encodeURIComponent(back)}`);
      return;
    }
    document.querySelector("h1")!.textContent = `Starting your ${planName(plan)} trial`;
    try {
      const { url } = await billingCheckout(session.access_token, plan, interval);
      if (!/^https:\/\//.test(url)) throw new CloudError(0, "bad_url", "Checkout returned an invalid address.");
      location.assign(url);
    } catch (e) {
      if (e instanceof CloudError && e.code === "already_subscribed") {
        fail("You already have a plan. Change or cancel it from Manage billing on your account page.");
      } else {
        fail(e instanceof Error ? e.message : "Something went wrong.");
      }
    }
  })();
</script>

<style>
  .progress {
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .progress[hidden] {
    display: none;
  }
  .progress i {
    display: block;
    width: 40%;
    height: 100%;
    background: var(--accent);
    border-radius: 3px;
    animation: slide 1.2s var(--ease) infinite;
  }
  @keyframes slide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(260%);
    }
  }
</style>
