---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import AuthForm from "../components/AuthForm.astro";
---
<Base title="Create your account" description="Create a Heed account and start your 14-day free trial." minimal>
  <Panel title="Create your account" lede="Then pick a plan. Both start with 14 days free.">
    <AuthForm mode="signup" />
    <p class="small">
      By continuing you agree to the <a href="/legal/terms">terms</a> and <a href="/legal/privacy">privacy policy</a>.
    </p>
    <p class="small">Already have an account? <a href="/signin">Sign in</a></p>
  </Panel>
</Base>
