---
import Base from "../layouts/Base.astro";
import AppIcon from "../components/AppIcon.astro";
import AppMark from "../components/AppMark.astro";
import HomeWindow from "../components/HomeWindow.astro";
import ApprovalCard from "../components/cards/ApprovalCard.astro";
import GhostCard from "../components/cards/GhostCard.astro";
import StepCard from "../components/cards/StepCard.astro";
import { APPS, label } from "../lib/apps";
import { FAQ } from "../lib/faq";
import { loadPlans, GITHUB_URL } from "../lib/plans";

const { plans } = await loadPlans();
const trial = plans[0]?.trial_days ?? 14;
const from = Math.min(...plans.map((p) => p.monthly_gbp));

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  footerCta={false}
  title="Heed"
  description="Heed reads your mail, calendar, docs and chats, tells you what needs you, answers with sources and writes for you anywhere on your Mac. You approve; it does the rest."
>
  <!-- Hero: one signal-blue field, one huge line, one monumental print. -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="sky" aria-hidden="true" data-sky><div class="drift"></div></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="kicker">Heed for Mac</p>
        <h1 id="hero-h">Everything that needs you. Nothing that doesn't.</h1>
        <p class="lede">
          Heed reads your mail, calendar, docs and chats, tells you what needs you, and writes wherever you type. You
          approve. It does the rest.
        </p>
        <div class="cta">
          <a class="btn btn-lg btn-cream" href="/pricing">Start free trial</a>
          <a class="btn btn-lg btn-glass" href="/download">Download for Mac</a>
        </div>
        <p class="sys">Heed Cloud: {trial}-day free trial · card needed · cancel any time before you're charged</p>
        <p class="oss">Open source · Apache-2.0 · <a href={GITHUB_URL} rel="noopener">View on GitHub</a></p>
      </div>
      <figure class="print">
        <img
          src="/art/painting-toledo.webp"
          srcset="/art/painting-toledo-720.webp 720w, /art/painting-toledo.webp 960w"
          sizes="(max-width: 760px) 360px, 34vw"
          alt="A storm over a hilltop city, printed in ultramarine on cream"
          width="960"
          height="1085"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>After El Greco, <i>View of Toledo</i>, c. 1600 · CC0</figcaption>
      </figure>
    </div>
  </section>

  <!-- One big product window, set into a painting. -->
  <section class="showcase" aria-label="The Heed app">
    <div class="wrap">
      <div class="canvas" data-bg>
        <div class="window-wrap" data-reveal><HomeWindow /></div>
      </div>
      <ul class="apps" data-apps aria-label="Apps Heed connects to">
        <li class="apps-k">Works with</li>
        {
          APPS.map((a) => (
            <li data-app={a.slug}>
              <AppMark slug={a.slug} size={16} />
              <span>{label(a)}</span>
            </li>
          ))
        }
        <li class="apps-more">More coming soon</li>
      </ul>
    </div>
  </section>

  <!-- Features: editorial blocks with big image tiles. -->
  <section id="product" class="section features" aria-labelledby="feat-h">
    <div class="wrap">
      <div class="feat-head">
        <h2 id="feat-h">What Heed does</h2>
        <p>Six things, done properly. Every answer cites where it came from, and nothing leaves your account without your say.</p>
      </div>
      <div class="grid">
        <article class="feat" data-reveal style="--i:0">
          <p class="tag">01 · Ask</p>
          <h3>Answers, with receipts.</h3>
          <p class="copy">Ask across every app at once. Each answer links to the exact email, event or doc it came from.</p>
          <div class="tile art-harvesters" data-bg>
            <div class="answer" aria-label="Example answer with sources">
              <p class="q">What did we agree with Driftwood about the freeze?</p>
              <p class="a">
                The freeze moves to <b>Friday 18:00</b>. Ines wanted a decision on pagination first
                <span class="chip"><AppIcon slug="notion" size={12} tile />RFC</span>, and Dev confirmed it this morning
                <span class="chip"><AppIcon slug="gmail" size={12} tile />Mail</span>.
              </p>
            </div>
          </div>
        </article>
        <article class="feat" data-reveal style="--i:1">
          <p class="tag">02 · Ghost text</p>
          <h3>Writes where you type.</h3>
          <p class="copy">Suggestions appear right after your cursor in any app on your Mac, in your voice. Press Tab to take one.</p>
          <div class="tile art-sky" data-bg><GhostCard /></div>
        </article>
        <article class="feat" data-reveal style="--i:2">
          <p class="tag">03 · Needs you</p>
          <h3>One list of what's waiting on you.</h3>
          <p class="copy">The replies, decisions and prep only you can do. Each item shows why it's there and the draft, ready to send.</p>
          <div class="tile art-andes" data-bg><ApprovalCard /></div>
        </article>
        <article class="feat" data-reveal style="--i:0">
          <p class="tag">04 · Daily brief</p>
          <h3>A calm brief every morning.</h3>
          <p class="copy">What changed overnight, what's on today, and the one meeting worth preparing for.</p>
          <div class="tile art-dither" data-bg role="img" aria-label="Dithered mountain landscape"></div>
        </article>
        <article class="feat" data-reveal style="--i:1">
          <p class="tag">05 · You approve</p>
          <h3>Nothing goes out without you.</h3>
          <p class="copy">Heed drafts the reply and finds the slot. You check it and approve. Every action is logged.</p>
          <div class="tile art-engr" data-bg>
            <div class="steps-wrap">
              <StepCard
                title="Reply to Margaret"
                meta="Needs you"
                steps={[
                  { label: "Found her question about Thursday", state: "done" },
                  { label: "Checked your calendar", detail: "Free from 14:00", state: "done" },
                  { label: "Drafted a reply", state: "done" },
                  { label: "Waiting for your approval", state: "current" },
                ]}
                actions={[{ label: "Pause" }, { label: "View draft", primary: true }]}
              />
            </div>
          </div>
        </article>
        <article class="feat" data-reveal style="--i:2">
          <p class="tag">06 · Connected</p>
          <h3>Your work, in one place.</h3>
          <p class="copy">Mail, calendar, Drive, Slack, Teams and Notion, kept in sync and searchable together.</p>
          <div class="tile art-land" data-bg role="img" aria-label="Engraved landscape with a low sun"></div>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works: hairlines, not boxes. -->
  <section id="how" class="section how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">It does the legwork.<br />You make the calls.</h2>
      <ol class="flow">
        <li><span class="n">01</span><b>Connect your apps</b><p>One click each, through the app's own sign-in. Heed never sees your passwords.</p></li>
        <li><span class="n">02</span><b>Heed reads and learns</b><p>It catches up on your history, then keeps in sync as new mail, events and docs arrive.</p></li>
        <li><span class="n">03</span><b>It drafts and asks</b><p>Replies, event changes and prep notes, ready for you to check.</p></li>
        <li><span class="n">04</span><b>You approve</b><p>Nothing leaves your account until you do.</p></li>
      </ol>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="section privacy" aria-labelledby="privacy-h">
    <div class="wrap">
      <figure class="painting" data-reveal>
        <img src="/art/painting-oxbow.webp" alt="A river bend under a clearing storm, printed in ultramarine on cream" width="1400" height="944" loading="lazy" decoding="async" />
        <div class="block"><p>Never sold.<br />Never used for training.</p></div>
        <figcaption>After Thomas Cole, <i>The Oxbow</i>, 1836. The Met, Open Access (CC0), duotoned.</figcaption>
      </figure>
      <div class="priv-in">
        <div>
          <p class="tag">Privacy</p>
          <h2 id="privacy-h">Your data, in plain English.</h2>
          <p class="muted">The free app keeps your data on your Mac. Heed Cloud runs in the cloud, and this is what that means for you.</p>
          <p class="more"><a href="/legal/privacy">Read the privacy policy</a></p>
        </div>
        <dl class="facts">
          <div><dt>Where it lives</dt><dd>Your synced items are stored in your account in London. To answer or write, Heed sends only the relevant snippets and your request to our AI provider, Anthropic, or OpenAI as a fallback.</dd></div>
          <div><dt>How it's protected</dt><dd>It's encrypted in transit and at rest, and each account is isolated at the database level. It isn't end-to-end encrypted, because Heed has to read it to help you.</dd></div>
          <div><dt>What we never do</dt><dd>We never sell your data, use it for ads or train models on it. Our AI providers don't train on API data by default.</dd></div>
          <div><dt>Passwords and actions</dt><dd>Apps connect through each app's own sign-in, so we never see your passwords. Sending an email or creating an event always waits for your approval.</dd></div>
          <div><dt>Leaving</dt><dd>When you disconnect an app, its data is deleted. When you delete your account, everything goes with it.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Get it -->
  <section class="get" aria-labelledby="get-h">
    <div class="wrap get-in">
      <div>
        <h2 id="get-h">Get Heed for Mac.</h2>
        <div class="cta left">
          <a class="btn btn-lg btn-primary" href="/download">Download for Mac</a>
          <a class="btn btn-lg btn-secondary" href={GITHUB_URL} rel="noopener">View on GitHub</a>
        </div>
        <pre class="install" aria-label="Get the source"><code><span class="c"># or get the source</span>
git clone https://github.com/rayhankhilji/nugget</code></pre>
      </div>
      <dl class="specs">
        <div><dt>System</dt><dd>macOS 11 Big Sur or later</dd></div>
        <div><dt>Chips</dt><dd>Apple silicon and Intel</dd></div>
        <div><dt>Free</dt><dd>Open source, Apache-2.0 · bring your own AI</dd></div>
        <div><dt>Heed Cloud</dt><dd>From £{from} a month · {trial}-day free trial, card needed · <a href="/pricing">compare plans</a></dd></div>
        <div><dt>Windows, Linux</dt><dd>Coming soon</dd></div>
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section faq" aria-labelledby="faq-h">
    <div class="wrap faq-in">
      <h2 id="faq-h">Questions, answered.</h2>
      <div class="qs">
        {
          FAQ.map((f) => (
            <details>
              <summary>
                {f.q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<script>
  // Sky parallax: at most 12px, and none under reduced motion. (The drift itself is pure CSS.)
  const layer = document.querySelector<HTMLElement>("[data-sky]");
  if (layer && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          layer.style.setProperty("--py", `${Math.min(12, scrollY * 0.03).toFixed(1)}px`);
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #f6f3ec;
    padding: clamp(56px, 8vw, 112px) 0 clamp(64px, 9vw, 128px);
  }
  /* Dithered sky (scripts/art/sky.mjs): 640x360 cells at 3x, so one tile is 1920x1080 CSS px and repeats
     seamlessly in x. The layer is two tiles wide and slides left one tile per 36s loop. */
  .sky {
    position: absolute;
    inset: -12px 0 0;
    z-index: -1;
    overflow: hidden;
    background: #070798;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  /* Anchored so the image's dark upper part (cream text keeps ≥6:1 there) sits behind the copy and only
     the cloud tops show along the hero's bottom edge. */
  .drift {
    position: absolute;
    left: 0;
    bottom: -420px;
    width: 3840px;
    height: 1080px;
    background: url("/art/sky-light.webp") 0 0 / 1920px 1080px repeat-x;
    image-rendering: pixelated;
    animation: drift 36s linear infinite;
    will-change: transform;
  }
  @keyframes drift {
    to {
      transform: translate3d(-1920px, 0, 0);
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sky {
      background-color: #0b0b1a;
    }
    :global(:root:not([data-theme="light"])) .drift {
      background-image: url("/art/sky-dark.webp");
    }
  }
  :global(:root[data-theme="dark"]) .sky {
    background-color: #0b0b1a;
  }
  :global(:root[data-theme="dark"]) .drift {
    background-image: url("/art/sky-dark.webp");
  }
  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(246 243 236 / 0.86);
  }
  h1 {
    font-size: clamp(52px, 8.4vw, 120px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 0.96;
  }
  .lede {
    max-width: 32em;
    font-size: clamp(17px, 1.5vw, 20px);
    color: rgb(246 243 236 / 0.92);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-cream {
    background: #f6f3ec;
    color: #14110f;
  }
  .btn-cream:hover {
    background: #fff;
  }
  .btn-glass {
    color: #f6f3ec;
    background: rgb(246 243 236 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(246 243 236 / 0.35);
  }
  .btn-glass:hover {
    background: rgb(246 243 236 / 0.18);
  }
  .sys {
    font-family: var(--mono);
    font-size: 12.5px;
    color: rgb(246 243 236 / 0.86);
  }
  .oss {
    margin-top: -14px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: rgb(246 243 236 / 0.86);
  }
  .oss a {
    color: #f6f3ec;
    text-underline-offset: 3px;
  }
  .print {
    margin: 0;
    padding: 12px 12px 10px;
    background: #f6f3ec;
    border-radius: 2px;
    box-shadow: 0 40px 80px -30px rgb(0 0 40 / 0.6);
    transform: rotate(1.2deg);
  }
  .print img {
    width: 100%;
    height: auto;
    aspect-ratio: 960 / 1085;
    display: block;
  }
  .print figcaption {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: #4a4540;
  }

  /* ---------- Showcase: one big window in a painting ---------- */
  .showcase {
    padding-top: clamp(56px, 7vw, 96px);
  }
  .canvas {
    padding: clamp(20px, 5vw, 72px);
    border-radius: 6px;
    --bg-img: url("/art/painting-cypresses.webp");
    background: #1f3bff center / cover no-repeat;
  }
  .window-wrap {
    max-width: 1080px;
    margin-inline: auto;
  }
  .apps {
    list-style: none;
    margin: 28px 0 0;
    padding: 18px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 24px;
    border-block: 1px dashed var(--line-2);
    font-size: 14px;
    color: var(--text-2);
  }
  .apps li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .apps-k,
  .apps-more {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }
  .apps-k {
    text-transform: uppercase;
  }

  /* ---------- Features ---------- */
  .feat-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .feat-head h2 {
    font-size: clamp(44px, 6.4vw, 88px);
  }
  .feat-head p {
    color: var(--text-2);
    font-size: 17px;
    max-width: 30em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(24px, 3vw, 40px);
    row-gap: 10px;
  }
  .feat:nth-child(n + 4) {
    margin-top: clamp(48px, 6vw, 80px);
  }
  /* Each feature spans four rows of the grid (tag, title, copy, tile) via subgrid, so tiles line up. */
  .feat {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 10px;
    align-content: start;
  }
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .feat h3 {
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: var(--heed-display-weight);
    letter-spacing: var(--heed-display-tracking);
    font-size: clamp(28px, 2.6vw, 34px);
    line-height: 1.08;
  }
  .copy {
    color: var(--text-2);
    font-size: 15.5px;
  }
  .tile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    margin-top: 12px;
    padding: 24px;
    aspect-ratio: 4 / 4.3;
    border-radius: 4px;
    overflow: hidden;
    background-color: #1f3bff;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .tile > :global(*) {
    position: relative;
  }
  .art-harvesters {
    --bg-img: url("/art/painting-harvesters.webp");
  }
  .art-andes {
    --bg-img: url("/art/painting-andes.webp");
  }
  .art-sky {
    --bg-img: url("/art/sky-light.webp");
    background-color: #070798;
    background-position: 30% 100%;
    background-size: auto 140%;
    background-repeat: repeat-x;
    image-rendering: pixelated;
  }
  .art-dither {
    --bg-img: url("/art/ds-dither.png");
    background-color: #e9ecff;
    background-position: 50% 100%;
    background-size: auto 100%;
    image-rendering: pixelated;
  }
  .art-engr {
    --bg-img: url("/art/ds-engr.webp");
    background-color: #f6f3ec;
    background-position: 50% 100%;
  }
  .art-land {
    --bg-img: url("/art/landscape-light.webp");
    background-color: #f6f3ec;
    background-position: 70% 100%;
    background-size: auto 100%;
  }
  .answer {
    width: 100%;
    max-width: 340px;
    padding: 16px;
    border-radius: var(--heed-radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    font-size: 14px;
  }
  .answer .q {
    margin-left: auto;
    width: fit-content;
    max-width: 88%;
    padding: 8px 12px;
    border-radius: 12px 12px 4px 12px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    margin-bottom: 12px;
  }
  .answer .a {
    color: var(--text-2);
    line-height: 1.7;
  }
  .answer b {
    color: var(--text);
    font-weight: 560;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 7px 0 3px;
    border-radius: 999px;
    font-size: 11.5px;
    line-height: 20px;
    color: var(--text-2);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    vertical-align: 0.06em;
  }
  .steps-wrap {
    width: 100%;
    max-width: 340px;
  }

  /* ---------- How ---------- */
  .how {
    border-top: 1px dashed var(--line-2);
  }
  .how h2 {
    font-size: clamp(40px, 5.6vw, 72px);
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .flow li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 24px 8px 0;
    border-top: 1px solid var(--text);
  }
  .flow li + li {
    padding-left: 24px;
    border-left: 1px dashed var(--line-2);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-3);
  }
  .flow b {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .flow p {
    color: var(--text-2);
    font-size: 15px;
  }

  /* ---------- Privacy ---------- */
  .painting {
    position: relative;
    margin: 0 0 clamp(40px, 6vw, 72px);
  }
  .painting img {
    width: 100%;
    height: clamp(280px, 40vw, 520px);
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: 4px;
    background: var(--heed-signal-wash);
    display: block;
  }
  .block {
    position: absolute;
    left: clamp(16px, 3vw, 40px);
    bottom: clamp(44px, 5vw, 72px);
    padding: clamp(18px, 2.4vw, 32px) clamp(20px, 3vw, 36px);
    background: var(--band);
    color: var(--on-band);
    border-radius: 2px;
    max-width: min(80%, 520px);
  }
  .block p {
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: var(--heed-display-weight);
    font-size: clamp(28px, 3.8vw, 48px);
    letter-spacing: var(--heed-display-tracking);
    line-height: 1.05;
  }
  .painting figcaption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .priv-in {
