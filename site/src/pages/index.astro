---
import Base from "../layouts/Base.astro";
import AppMark from "../components/AppMark.astro";
import { APPS, label } from "../lib/apps";
import BriefCard from "../components/cards/BriefCard.astro";
import ApprovalCard from "../components/cards/ApprovalCard.astro";
import GhostCard from "../components/cards/GhostCard.astro";
import StepCard from "../components/cards/StepCard.astro";
import WeekStats from "../components/WeekStats.astro";
import { FAQ } from "../lib/faq";
import { loadPlans } from "../lib/plans";

const { plans } = await loadPlans();
const trial = plans[0]?.trial_days ?? 14;


const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Heed"
  description="Heed reads your mail, calendar, docs and chats, tells you what needs you, answers with sources and writes for you anywhere on your Mac. You approve; it does the rest."
>
  <!-- Hero: a Fraunces line over a drifting dithered sky, with product cards floating over the clouds. -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="sky" aria-hidden="true" data-sky><div class="drift"></div></div>
    <div class="wrap hero-copy">
      <p class="kicker">Heed for Mac · {trial}-day free trial</p>
      <h1 id="hero-h">Everything that needs you.<br /><em>Nothing that doesn't.</em></h1>
      <p class="lede">
        Heed reads your mail, calendar, docs and chats. It tells you what needs you, answers with sources and writes
        wherever you type. You approve, and it does the rest.
      </p>
      <div class="cta">
        <a class="btn btn-lg btn-cream" href="/pricing">Start free trial</a>
        <a class="btn btn-lg btn-glass" href="/download">Download for Mac</a>
      </div>
    </div>
    <div class="wrap stage">
      <div class="float f1" data-reveal style="--i:0"><BriefCard /></div>
      <div class="float f2" data-reveal style="--i:2"><GhostCard /></div>
      <div class="float f3" data-reveal style="--i:4"><ApprovalCard /></div>
    </div>
  </section>

  <!-- Apps -->
  <section class="apps" aria-labelledby="apps-h">
    <div class="wrap">
      <h2 id="apps-h" class="apps-h">Connects to the apps you already live in</h2>
      <ul class="apps-row" data-apps>
        {
          APPS.map((a) => (
            <li data-app={a.slug}>
              <AppMark slug={a.slug} />
              <span>{label(a)}</span>
            </li>
          ))
        }
      </ul>
      <p class="apps-more">More coming soon.</p>
    </div>
  </section>

  <!-- Feature band: one big signal field -->
  <section id="product" class="band" aria-labelledby="band-h">
    <div class="band-dots" aria-hidden="true"></div>
    <div class="wrap band-in">
      <h2 id="band-h">One assistant that has read everything,<br />so you don't have to.</h2>
      <div class="feats">
        <article data-reveal style="--i:0">
          <span class="n">01</span>
          <h3>Answers, with receipts</h3>
          <p>Ask across every app at once. Each answer links to the exact email, event or doc it came from.</p>
        </article>
        <article data-reveal style="--i:1">
          <span class="n">02</span>
          <h3>Writes where you type</h3>
          <p>Ghost text in any field on your Mac, in your voice and grounded in your work. Press Tab to take it.</p>
        </article>
        <article data-reveal style="--i:2">
          <span class="n">03</span>
          <h3>Knows what needs you</h3>
          <p>One short list of the replies, decisions and prep only you can do, and a calm brief every morning.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- This week -->
  <section class="section week-sec" aria-labelledby="week-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">An example week</p>
        <h2 id="week-h">What Heed did for you this week.</h2>
        <p>Every Monday, Heed shows you what it handled, from the searches you skipped to the drafts you approved. These figures are from an illustrative week.</p>
      </div>
      <WeekStats />
    </div>
  </section>

  <!-- How it works: three cream cards, each in the agent-progress pattern -->
  <section id="how" class="section how dots-bg" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">It does the legwork.<br />You make the calls.</h2>
      </div>
      <ol class="how-cards">
        <li data-reveal style="--i:0">
          <p class="how-n"><span>01</span> Connect your apps</p>
          <StepCard
            title="Connecting"
            meta="2 of 4"
            steps={[
              { label: "Gmail", icon: "gmail", state: "done" },
              { label: "Google Calendar", icon: "googlecalendar", state: "done" },
              { label: "Google Drive", icon: "googledrive", state: "current" },
              { label: "Notion", icon: "notion", state: "pending" },
            ]}
          />
          <p class="how-p">One click each, through the app's own sign-in. Heed never sees your passwords.</p>
        </li>
        <li data-reveal style="--i:1">
          <p class="how-n"><span>02</span> Heed reads and learns</p>
          <StepCard
            title="Catching up"
            meta="12,408 items"
            steps={[
              { label: "Read 12 months of mail", detail: "9,862 threads", state: "done" },
              { label: "Learned who matters", detail: "38 regular contacts", state: "done" },
              { label: "Mapping projects and deadlines", detail: "Driftwood, Moorland, Q4 board", state: "current" },
            ]}
          />
          <p class="how-p">It catches up on your history, then stays in sync as new mail, events and docs arrive.</p>
        </li>
        <li data-reveal style="--i:2">
          <p class="how-n"><span>03</span> It drafts, you approve</p>
          <StepCard
            title="Reply to Margaret"
            meta="Needs you"
            steps={[
              { label: "Found her question about Thursday", state: "done" },
              { label: "Checked your calendar", detail: "Free from 14:00", state: "done" },
              { label: "Drafted a reply", state: "done" },
              { label: "Waiting for your approval", state: "current" },
            ]}
            actions={[{ label: "Pause" }, { label: "View draft", primary: true }]}
          />
          <p class="how-p">Nothing leaves your account until you approve it, and every action is logged.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="section privacy" aria-labelledby="privacy-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Privacy</p>
        <h2 id="privacy-h">Your data, in plain English.</h2>
        <p>Heed runs in the cloud, not on your Mac. This is what that means for you.</p>
      </div>
      <figure class="painting" data-reveal>
        <img src="/art/painting-oxbow.webp" alt="A river bend under a clearing storm, printed in ultramarine on cream" width="1400" height="944" loading="lazy" decoding="async" />
        <div class="block"><p>Never sold.<br />Never used for training.</p></div>
        <figcaption>After Thomas Cole, <i>The Oxbow</i>, 1836. The Met, Open Access (CC0), duotoned.</figcaption>
      </figure>
      <dl class="facts">
        <div data-reveal style="--i:0">
          <dt>Where it lives</dt>
          <dd>Your synced items are stored in your account in London. To answer or write, Heed sends only the relevant snippets and your request to our AI provider, Anthropic, or OpenAI as a fallback.</dd>
        </div>
        <div data-reveal style="--i:1">
          <dt>How it's protected</dt>
          <dd>It's encrypted in transit and at rest, and each account is isolated at the database level. It isn't end-to-end encrypted, because Heed has to read it to help you.</dd>
        </div>
        <div data-reveal style="--i:2">
          <dt>What we never do</dt>
          <dd>We never sell your data, use it for ads or train models on it. Our AI providers don't train on API data by default.</dd>
        </div>
        <div data-reveal style="--i:3">
          <dt>Passwords</dt>
          <dd>We never see them. Apps connect through Composio using each app's own sign-in, and you can revoke access at any time.</dd>
        </div>
        <div data-reveal style="--i:4">
          <dt>Actions</dt>
          <dd>Sending an email or creating an event always waits for your approval.</dd>
        </div>
        <div data-reveal style="--i:5">
          <dt>Leaving</dt>
          <dd>When you disconnect an app, its data is deleted. When you delete your account, everything goes with it.</dd>
        </div>
      </dl>
      <p class="more"><a href="/legal/privacy">Read the privacy policy</a></p>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section teaser" aria-labelledby="teaser-h">
    <div class="wrap teaser-in">
      <div>
        <p class="eyebrow">Pricing</p>
        <h2 id="teaser-h">Two plans.<br />A {trial}-day free trial.</h2>
        <p class="muted">A card is required to start, and you can cancel before day {trial} without being charged. There's no free plan.</p>
        <a class="btn btn-secondary" href="/pricing">Compare plans</a>
      </div>
      <div class="mini">
        {
          plans.map((p, i) => (
            <a class:list={["mini-card", { hl: p.highlight }]} href={`/checkout?plan=${p.id}&interval=month`} data-reveal style={`--i:${i}`}>
              <span class="mini-name">{p.name}</span>
              <span class="mini-price">
                <span class="amt">£{p.monthly_gbp}</span>
                <small>/ month</small>
              </span>
              <span class="mini-sub">or £{p.annual_gbp} a year · {p.features[0]}</span>
              <span class="mini-go">Start free trial →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section faq" aria-labelledby="faq-h">
    <div class="wrap faq-in">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Questions, answered.</h2>
      </div>
      <div class="qs">
        {
          FAQ.map((f) => (
            <details>
              <summary>
                {f.q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<script>
  // Sky parallax: at most 12px, and none under reduced motion. (The drift itself is pure CSS.)
  const layer = document.querySelector<HTMLElement>("[data-sky]");
  if (layer && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          layer.style.setProperty("--py", `${Math.min(12, scrollY * 0.03).toFixed(1)}px`);
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(64px, 9vw, 120px);
    color: #f6f3ec;
    isolation: isolate;
  }
  /* Dithered sky (scripts/art/sky.mjs): 640x360 cells shown 3x with nearest-neighbour scaling, so one
     tile is 1920x1080 CSS px and repeats seamlessly in x. The layer is two tiles wide and slides left
     by exactly one tile per 36s loop. Above the image, the top colour carries on. */
  .sky {
    position: absolute;
    inset: -12px 0 0;
    z-index: -1;
    overflow: hidden;
    background: #070798;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .drift {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 3840px;
    height: 1080px;
    background: url("/art/sky-light.webp") 0 100% / 1920px 1080px repeat-x;
    image-rendering: pixelated;
    animation: drift 36s linear infinite;
    will-change: transform;
  }
  @keyframes drift {
    to {
      transform: translate3d(-1920px, 0, 0);
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sky {
      background-color: #0b0b1a;
    }
    :global(:root:not([data-theme="light"])) .drift {
      background-image: url("/art/sky-dark.webp");
    }
  }
  :global(:root[data-theme="dark"]) .sky {
    background-color: #0b0b1a;
  }
  :global(:root[data-theme="dark"]) .drift {
    background-image: url("/art/sky-dark.webp");
  }
  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }
  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(246 243 236 / 0.86);
  }
  h1 {
    font-size: clamp(44px, 8.2vw, 96px);
    font-weight: 320;
    letter-spacing: -0.025em;
    line-height: 1;
    max-width: 20ch;
  }
  h1 em {
    font-style: normal;
    color: #cdd3ff;
  }
  .lede {
    max-width: 38em;
    font-size: clamp(16px, 1.6vw, 19px);
    color: rgb(246 243 236 / 0.9);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  .btn-cream {
    background: #f6f3ec;
    color: #14110f;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.5);
  }
  .btn-cream:hover {
    background: #ffffff;
  }
  .btn-glass {
    color: #f6f3ec;
    background: rgb(246 243 236 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(246 243 236 / 0.3);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .btn-glass:hover {
    background: rgb(246 243 236 / 0.2);
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    margin-top: clamp(56px, 7vw, 88px);
    padding-bottom: clamp(56px, 7vw, 96px);
    color: var(--text);
  }
  .float {
    display: flex;
    justify-content: center;
  }
  .f1 {
    margin-top: 64px;
  }
  .f3 {
    margin-top: 110px;
  }

  /* Apps */
  .apps {
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .apps-h {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--text-2);
    text-align: center;
    margin-bottom: 16px;
  }
  .apps-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    color: var(--text-2);
  }
  .apps-more {
    margin-top: 14px;
    text-align: center;
    font-size: 13px;
    color: var(--text-3);
  }
  .apps-row li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  /* Feature band */
  .band {
    position: relative;
    background: var(--band);
    color: var(--on-band);
    padding: clamp(80px, 11vw, 140px) 0;
    overflow: hidden;
  }
  .band-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.16) 1px, transparent 1.6px);
    background-size: 18px 18px;
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }
  .band-in {
    position: relative;
  }
  .band h2 {
    font-size: clamp(36px, 5.4vw, 72px);
    max-width: 18ch;
    margin-bottom: clamp(48px, 7vw, 88px);
  }
  .feats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
  }
  .feats article {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: rgb(255 255 255 / 0.85);
  }
  .feats h3 {
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: 380;
    font-size: 28px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .feats p {
    color: rgb(255 255 255 / 0.9);
    font-size: 16px;
  }

  /* How */
  .dots-bg {
    background-image: radial-gradient(circle at 1px 1px, var(--grid) 1px, transparent 1.5px);
    background-size: 16px 16px;
  }
  .how {
    border-block: 1px solid var(--line);
  }
  .how-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  .how-cards > li {
    display: grid;
    gap: 14px;
    padding: 20px;
    border-radius: var(--heed-radius-xl);
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .how-n {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: var(--heed-display-weight);
    font-size: 28px;
    letter-spacing: var(--heed-display-tracking);
    line-height: 1.1;
  }
  .how-n span {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--text-3);
  }
  .how-p {
    color: var(--text-2);
    font-size: 15px;
  }

  /* Privacy */
  .painting {
    position: relative;
    margin: 0 0 56px;
  }
  .painting img {
    width: 100%;
    height: clamp(260px, 36vw, 440px);
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--heed-radius-l);
    background: var(--heed-signal-wash);
  }
  .block {
    position: absolute;
    left: clamp(16px, 3vw, 32px);
    bottom: clamp(44px, 5vw, 64px);
    padding: clamp(18px, 2.4vw, 28px) clamp(20px, 3vw, 32px);
    background: var(--band);
    color: var(--on-band);
    border-radius: 4px;
    max-width: min(80%, 460px);
  }
  .block p {
    font-family: var(--display);
    font-variation-settings: var(--heed-display-settings);
    font-weight: var(--heed-display-weight);
    font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: var(--heed-display-tracking);
    line-height: 1.08;
  }
  .painting figcaption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 40px;
  }
  .facts div {
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-2);
    margin-bottom: 10px;
  }
  .facts dd {
    margin: 0;
    font-size: 16px;
    color: var(--text);
    line-height: 1.55;
  }
  .more {
    margin-top: 32px;
  }
  .more a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
    font-size: 18px;
  }

  /* Teaser */
  .teaser {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .teaser-in {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .teaser-in > div:first-child {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .teaser h2 {
    font-size: clamp(36px, 5vw, 60px);
  }
  .mini {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .mini-card {
    display: grid;
    gap: 10px;
    padding: 22px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-2);
    text-decoration: none;
    transition:
      transform var(--t-ui) var(--ease),
      box-shadow var(--t-ui) var(--ease);
  }
  .mini-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-3);
  }
  .mini-card.hl {
    background: #0b0b1a;
    color: #f3f1ec;
  }
  .mini-name {
    font-weight: 600;
  }
  .mini-price .amt {
    font-family: var(--mono);
    font-size: 48px;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .mini-price small {
    margin-left: 4px;
    font-size: 14px;
    opacity: 0.8;
  }
  .mini-sub {
    font-size: 13.5px;
    color: var(--text-2);
  }
  .hl .mini-sub {
    color: #b9b6c8;
  }
  .mini-go {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 550;
    color: var(--text);
  }
  .hl .mini-go {
    color: #f3f1ec;
  }

  /* FAQ */
  .faq-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: start;
  }
  .qs {
    border-top: 1px solid var(--line-2);
  }
  details {
    border-bottom: 1px solid var(--line-2);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    font-weight: 540;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
