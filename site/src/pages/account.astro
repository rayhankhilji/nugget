---
import Base from "../layouts/Base.astro";
import { loadPlans } from "../lib/plans";
const { plans } = await loadPlans();
const limits = JSON.stringify(Object.fromEntries(plans.map((p) => [p.id, p.entitlements.devices])));
---
<Base title="Account" description="Your Heed plan, billing and devices." noindex>
  <section class="wrap acct" data-account data-limits={limits} aria-busy="true">
    <header class="head">
      <div>
        <h1>Account</h1>
        <p class="muted" data-email>Loading…</p>
      </div>
      <button type="button" class="btn btn-secondary btn-sm" data-signout>Sign out</button>
    </header>

    <p class="status" role="status" aria-live="polite" data-msg hidden></p>

    <div class="grid">
      <section class="box plan" aria-labelledby="plan-h">
        <div class="box-h">
          <h2 id="plan-h">Plan</h2>
          <span class="pill" data-status hidden></span>
        </div>
        <p class="plan-name" data-plan><span class="sk" style="width:140px"></span></p>
        <p class="muted" data-plan-detail><span class="sk" style="width:220px"></span></p>
        <div class="row">
          <button type="button" class="btn btn-primary btn-sm" data-portal hidden>Manage billing</button>
          <a href="/pricing" class="btn btn-primary btn-sm" data-choose hidden>Choose a plan</a>
          <a href="/pricing" class="btn btn-ghost btn-sm" data-compare>Compare plans</a>
        </div>
        <p class="small">Billing, invoices, card details and cancelling are handled securely by Stripe.</p>
      </section>

      <section class="box" aria-labelledby="dl-h">
        <div class="box-h"><h2 id="dl-h">Heed for Mac</h2></div>
        <p class="muted">macOS 11 or later, Apple silicon and Intel. Sign in inside the app with the same email.</p>
        <div class="row"><a href="/download" class="btn btn-secondary btn-sm">Download</a></div>
      </section>

      <section class="box devices" aria-labelledby="dev-h">
        <div class="box-h">
          <h2 id="dev-h">Devices</h2>
          <span class="muted small" data-dev-limit></span>
        </div>
        <ul data-devices><li class="muted">Loading…</li></ul>
        <p class="small">Devices count towards your plan's limit for 30 days after they were last used.</p>
      </section>

      <section class="box danger" aria-labelledby="del-h">
        <div class="box-h"><h2 id="del-h">Delete account</h2></div>
        <p class="muted">
          Disconnects every app and permanently deletes your account and all synced data. Cancel your plan in Manage
          billing first if you don't want to be charged again.
        </p>
        <form data-delete>
          <label class="field">
            <span>Type <strong>delete</strong> to confirm</span>
            <input class="input" name="confirm" autocomplete="off" spellcheck="false" />
          </label>
          <button type="submit" class="btn btn-sm danger-btn">Delete my account</button>
        </form>
      </section>
    </div>
  </section>
</Base>

<script>
  import { supabase } from "../lib/supabase";
  import { billingPortal, deleteAccount, CloudError } from "../lib/cloud";
  import { planName } from "../lib/plans";

  interface Sub {
    plan: string;
    interval: string;
    status: string;
    trial_end: string | null;
    current_period_end: string | null;
    cancel_at_period_end: boolean;
  }
  interface Device {
    device_id: string;
    first_seen_at: string;
    last_seen_at: string;
  }

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const msg = $("[data-msg]");
  const say = (text: string, err = false) => {
    msg.textContent = text;
    msg.classList.toggle("err", err);
    msg.hidden = false;
  };
  const date = (iso: string | null) =>
    iso ? new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "";
  const LIVE = new Set(["trialing", "active", "past_due"]);
  const LABEL: Record<string, string> = {
    trialing: "Trial",
    active: "Active",
    past_due: "Payment due",
    canceled: "Cancelled",
    unpaid: "Unpaid",
    incomplete: "Incomplete",
  };

  (async () => {
    const sb = supabase();
    if (!sb) {
      say("Accounts aren't configured for this build.", true);
      $("[data-email]").textContent = "";
      return;
    }
    const { data } = await sb.auth.getSession();
    const session = data.session;
    if (!session) {
      location.replace(`/signin?next=${encodeURIComponent("/account")}`);
      return;
    }
    $("[data-email]").textContent = session.user.email ?? "";
    if (new URLSearchParams(location.search).get("billing") === "done") say("Thanks. Your plan is being set up.");

    // Read straight from Supabase: row-level security limits these to the signed-in user.
    const [subs, devs] = await Promise.all([
      sb.from("subscriptions").select("plan,interval,status,trial_end,current_period_end,cancel_at_period_end").order("updated_at", { ascending: false }),
      sb.from("devices").select("device_id,first_seen_at,last_seen_at").order("last_seen_at", { ascending: false }),
    ]);
    $("[data-account]").setAttribute("aria-busy", "false");

    const rows = (subs.data ?? []) as Sub[];
    const sub = rows.find((s) => LIVE.has(s.status)) ?? rows[0];
    const live = sub && LIVE.has(sub.status);
    const status = $("[data-status]");
    if (sub) {
      $("[data-plan]").textContent = `${planName(sub.plan)}, ${sub.interval === "year" ? "annual" : "monthly"}`;
      status.textContent = LABEL[sub.status] ?? sub.status;
      status.dataset["tone"] = live ? (sub.status === "past_due" ? "warn" : "ok") : "off";
      status.hidden = false;
      const end = date(sub.current_period_end);
      $("[data-plan-detail]").textContent =
        sub.status === "trialing"
          ? `Free trial until ${date(sub.trial_end)}. ${sub.cancel_at_period_end ? "It won't renew." : "Your first payment is taken then."}`
          : sub.cancel_at_period_end && live
            ? `Cancelled. You keep access until ${end}.`
            : live
              ? `Renews on ${end}.`
              : "No active subscription.";
      $("[data-portal]").hidden = false;
    } else {
      $("[data-plan]").textContent = "No plan yet";
      $("[data-plan-detail]").textContent = "Start a 14-day free trial to connect your apps.";
    }
    if (!live) {
      $("[data-choose]").hidden = false;
      $("[data-compare]").hidden = true;
    }
    if (subs.error) say("We couldn't load your plan. Refresh to try again.", true);

    const limits = JSON.parse($("[data-account]").dataset["limits"] ?? "{}") as Record<string, number>;
    const limit = live ? (limits[sub.plan] ?? 1) : 0;
    const list = $("[data-devices]");
    const devices = (devs.data ?? []) as Device[];
    $("[data-dev-limit]").textContent = live ? `${devices.length} of ${limit}` : "";
    const renderDevices = (items: Device[]) => {
      list.replaceChildren();
      if (!items.length) {
        const li = document.createElement("li");
        li.className = "muted";
        li.textContent = "No devices yet. Sign in on your Mac to add one.";
        list.append(li);
        return;
      }
      for (const d of items) {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.innerHTML = `<b></b><small class="muted"></small>`;
        label.querySelector("b")!.textContent = d.device_id === "unnamed-client" ? "Unnamed client" : `Device ${d.device_id.slice(0, 8)}`;
        label.querySelector("small")!.textContent = `Last used ${date(d.last_seen_at)}`;
        const rm = document.createElement("button");
        rm.type = "button";
        rm.className = "btn btn-ghost btn-sm";
        rm.textContent = "Remove";
        rm.setAttribute("aria-label", `Remove ${label.querySelector("b")!.textContent}`);
        rm.addEventListener("click", async () => {
          rm.disabled = true;
          const { error } = await sb.from("devices").delete().eq("device_id", d.device_id);
          if (error) {
            rm.disabled = false;
            say("We couldn't remove that device.", true);
            return;
          }
          const rest = items.filter((x) => x !== d);
          $("[data-dev-limit]").textContent = live ? `${rest.length} of ${limit}` : "";
          renderDevices(rest);
        });
        li.append(label, rm);
        list.append(li);
      }
    };
    renderDevices(devices);

    $("[data-portal]").addEventListener("click", async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      try {
        const { url } = await billingPortal(session.access_token);
        if (!/^https:\/\//.test(url)) throw new Error("Billing returned an invalid address.");
        location.assign(url);
      } catch (err) {
        b.disabled = false;
        say(err instanceof Error ? err.message : "We couldn't open billing.", true);
      }
    });

    $("[data-signout]").addEventListener("click", async () => {
      await sb.auth.signOut();
      location.replace("/");
    });

    $<HTMLFormElement>("[data-delete]").addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const typed = (form.elements.namedItem("confirm") as HTMLInputElement).value.trim().toLowerCase();
      if (typed !== "delete") {
        say("Type delete to confirm.", true);
        return;
      }
      const b = form.querySelector("button")!;
      b.disabled = true;
      try {
        await deleteAccount(session.access_token);
        await sb.auth.signOut().catch(() => undefined);
        location.replace("/?deleted=1");
      } catch (err) {
        b.disabled = false;
        say(err instanceof CloudError ? err.message : "We couldn't delete your account. Try again.", true);
      }
    });
  })();
</script>

<style>
  .acct {
    padding-block: 48px 96px;
    display: grid;
    gap: 24px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  h1 {
    font-size: clamp(30px, 4vw, 40px);
    margin-bottom: 4px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .box {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    border-radius: var(--r-4);
    background: var(--surface);
    box-shadow: var(--shadow-1), var(--hi);
  }
  .box-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  h2 {
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .plan-name {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .pill {
    font-size: 12px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-2);
  }
  .pill[data-tone="ok"] {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .pill[data-tone="warn"] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .row [hidden] {
    display: none;
  }
  .sk {
    display: inline-block;
    max-width: 100%;
    height: 1em;
    border-radius: 6px;
    background: var(--surface-2);
    vertical-align: middle;
  }
  .devices ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .devices :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .devices :global(li span) {
    display: grid;
  }
  .devices :global(li b) {
    font-weight: 550;
  }
  .danger form {
    display: grid;
    gap: 12px;
  }
  .danger-btn {
    justify-self: start;
    background: transparent;
    color: var(--accent-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .danger-btn:hover {
    background: var(--accent-soft);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
