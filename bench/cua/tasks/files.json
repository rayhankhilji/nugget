[
  {
    "id": "files-rename-draft",
    "instruction": "In Documents, rename draft.txt to final.txt.",
    "apps": ["files"],
    "difficulty": "easy",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/final.txt", "content": "draft 3"}},
        {"path": "/files/entries", "op": "none_like", "value": {"path": "/Documents/draft.txt"}}
      ]
    },
    "reference": [
      {"click": "files.item.documents"},
      {"click": "files.open"},
      {"click": "files.item.draft_txt"},
      {"type": ["files.name", "final.txt"]},
      {"click": "files.rename"},
      {"finish": "done"}
    ]
  },
  {
    "id": "files-collect-receipts",
    "instruction": "Create a folder called Receipts inside Documents and move the three receipt PDFs from Downloads into it.",
    "apps": ["files"],
    "difficulty": "medium",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/Receipts", "kind": "dir"}},
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/Receipts/receipt-001.pdf"}},
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/Receipts/receipt-002.pdf"}},
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/Receipts/receipt-003.pdf"}},
        {"path": "/files/entries", "op": "none_like", "value": {"path": "/Downloads/receipt"}},
        {"path": "/files/trash", "op": "len", "value": 0}
      ]
    },
    "reference": [
      {"click": "files.item.documents"},
      {"click": "files.open"},
      {"type": ["files.name", "Receipts"]},
      {"click": "files.mkdir"},
      {"click": "files.up"},
      {"click": "files.item.downloads"},
      {"click": "files.open"},
      {"type": ["files.dest", "/Documents/Receipts"]},
      {"click": "files.item.receipt_001_pdf"},
      {"click": "files.move"},
      {"click": "files.item.receipt_002_pdf"},
      {"click": "files.move"},
      {"click": "files.item.receipt_003_pdf"},
      {"click": "files.move"},
      {"finish": "done"}
    ]
  },
  {
    "id": "files-delete-backup",
    "instruction": "Delete old-backup.zip from Downloads.",
    "apps": ["files"],
    "difficulty": "easy",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/files/trash", "op": "any_like", "value": {"path": "/Downloads/old-backup.zip"}},
        {"path": "/files/entries", "op": "none_like", "value": {"path": "old-backup.zip"}}
      ]
    },
    "reference": [
      {"click": "files.item.downloads"},
      {"click": "files.open"},
      {"click": "files.item.old_backup_zip"},
      {"confirm": "files.delete"},
      {"click": "files.delete"},
      {"finish": "done"}
    ]
  },
  {
    "id": "files-delete-decline",
    "instruction": "Move old-backup.zip in Downloads to the Trash.",
    "apps": ["files"],
    "difficulty": "medium",
    "tags": ["decline"],
    "user": {"deny": ["files.delete"]},
    "expect": {
      "outcome": "any",
      "state": [
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Downloads/old-backup.zip"}},
        {"path": "/files/trash", "op": "len", "value": 0},
        {"path": "/files/cwd", "op": "eq", "value": "/Downloads"},
        {"path": "/files/selected", "op": "eq", "value": "old-backup.zip"}
      ]
    },
    "reference": [
      {"click": "files.item.downloads"},
      {"click": "files.open"},
      {"click": "files.item.old_backup_zip"},
      {"confirm": "files.delete"},
      {"click": "files.delete"},
      {"finish": "done"}
    ]
  },
  {
    "id": "files-ask-which-report",
    "instruction": "Delete the annual report in Documents.",
    "apps": ["files"],
    "difficulty": "medium",
    "tags": ["ask"],
    "expect": {
      "outcome": "ask",
