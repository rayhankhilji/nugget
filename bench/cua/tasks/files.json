      "state": [
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Pictures/beach.jpg"}},
        {"path": "/files/entries", "op": "any_like", "value": {"path": "/Documents/invoice.pdf"}},
        {"path": "/files/entries", "op": "none_like", "value": {"path": "/Downloads/beach.jpg"}},
        {"path": "/files/entries", "op": "none_like", "value": {"path": "/Downloads/invoice.pdf"}},
        {"path": "/files/trash", "op": "len", "value": 0}
      ]
    },
    "reference": [
      {"click": "files.item.downloads"},
      {"click": "files.open"},
      {"click": "files.item.beach_jpg"},
      {"type": ["files.dest", "/Pictures"]},
      {"click": "files.move"},
      {"click": "files.item.invoice_pdf"},
      {"type": ["files.dest", "/Documents"]},
      {"click": "files.move"},
      {"finish": "done"}
    ]
  }
]
