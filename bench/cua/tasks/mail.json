  {
    "id": "mail-reply-lunch",
    "instruction": "Reply to Priya's email about lunch and tell her Thursday at 12:30 works for me.",
    "apps": ["mail"],
    "difficulty": "easy",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/mail/sent", "op": "len", "value": 1},
