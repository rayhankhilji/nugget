      ]
    },
    "reference": [
      {"click": "mail.open.m1"},
      {"click": "mail.reply"},
      {"type": ["mail.compose.body", "Hi Priya, Thursday at 12:30 works for me. See you then!"]},
      {"confirm": "mail.send"},
      {"click": "mail.send"},
      {"finish": "done"}
    ]
  },
