[
  {
    "id": "calendar-book-dentist",
    "instruction": "Add a dentist appointment to my calendar on Tuesday at 10:00. It's just for me.",
    "apps": ["calendar"],
    "difficulty": "easy",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/calendar/events", "op": "any_like", "value": {"day": "Tuesday", "hour": 10, "title": "dentist", "attendees": []}},
        {"path": "/calendar/events", "op": "len", "value": 6}
      ]
    },
    "reference": [
      {"select": ["calendar.new.day", "Tuesday"]},
      {"select": ["calendar.new.time", "10:00"]},
      {"type": ["calendar.new.title", "Dentist"]},
      {"click": "calendar.save"},
      {"finish": "done"}
    ]
  },
