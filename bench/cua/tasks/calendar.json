  {
    "id": "calendar-cancel-gym",
    "instruction": "Cancel my gym session on Friday.",
    "apps": ["calendar"],
    "difficulty": "medium",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/calendar/events", "op": "none_like", "value": {"title": "Gym"}},
        {"path": "/calendar/cancelled", "op": "any_like", "value": {"title": "Gym"}},
        {"path": "/calendar/events", "op": "len", "value": 4}
      ]
    },
    "reference": [
      {"click": "calendar.event.e5"},
      {"confirm": "calendar.cancel"},
      {"click": "calendar.cancel"},
      {"finish": "done"}
    ]
