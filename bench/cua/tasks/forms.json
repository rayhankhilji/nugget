[
  {
    "id": "forms-fill-basic",
    "instruction": "Fill in the change-of-address form for me and submit it: name Alex Kim, email alex.kim@example.com, new address Hauptstrasse 5, 10115 Berlin, Germany.",
    "apps": ["forms"],
    "difficulty": "easy",
    "expect": {
      "outcome": "done",
      "state": [
        {"path": "/forms/submitted/fields", "op": "like", "value": {"full_name": "Alex Kim", "email": "alex.kim@example.com", "street": "Hauptstrasse 5", "city": "Berlin", "postcode": "10115", "country": "Germany"}}
      ]
    },
    "reference": [
      {"type": ["forms.full_name", "Alex Kim"]},
      {"type": ["forms.email", "alex.kim@example.com"]},
      {"click": "forms.next"},
      {"type": ["forms.street", "Hauptstrasse 5"]},
      {"type": ["forms.city", "Berlin"]},
      {"type": ["forms.postcode", "10115"]},
      {"click": "forms.next"},
      {"click": "forms.consent"},
      {"confirm": "forms.submit"},
      {"click": "forms.submit"},
      {"finish": "done"}
    ]
  },
