# Heed Cloud, self-hosted: settings for docker-compose.yml. Copy to .env and fill in.
# Community-supported. No warranty or support from Heed.
# Never commit .env: it holds secrets.

# ---- Public address ------------------------------------------------------------------------
# Where the desktop app and browsers reach this server. Local test: http://localhost:8000.
# Real server: https://heed.example.com, with SITE_ADDRESS=heed.example.com and
# docker-compose.domain.yml. The desktop app accepts plain http only for localhost.
PUBLIC_URL=http://localhost:8000
SITE_ADDRESS=:8000
PUBLIC_PORT=8000

# ---- Secrets: generate with ./gen-keys.sh and paste here -----------------------------------
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
SERVICE_DB_PASSWORD=
JWT_SECRET=
# Public by design (the desktop app ships it); the service-role key is secret.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sign-in (GoTrue) -----------------------------------------------------------------------
# Deep links the app may be sent back to after sign-in.
APP_REDIRECTS=nugget://auth/callback,heed://auth/callback
# Set to true once your own account exists, to stop strangers signing up.
DISABLE_SIGNUP=false
# Mail for magic links. The defaults use the "dev" profile's Mailpit (http://localhost:8025),
# which delivers nothing and needs no login. For real use, point these at your SMTP provider
# (port 465 or 587 with TLS; the auth server will not send a password over plain SMTP).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=heed@localhost
# Google sign-in (optional): an OAuth web client with redirect URI {PUBLIC_URL}/auth/v1/callback.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ---- Billing ---------------------------------------------------------------------------------
# Off for self-hosting: no Stripe, and every signed-in user gets NUGGET_SELFHOST_PLAN's limits
# (from crates/nugget-cloud/plans.toml; heed_max unless set).
NUGGET_BILLING=off
NUGGET_SELFHOST_PLAN=heed_max

# ---- Integrations: Composio (your own account) -----------------------------------------------
# API key from your Composio project; auth configs created there for each toolkit.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIGS=gmail=ac_...,googlecalendar=ac_...
# Optional: verify Composio webhooks (trigger events).
COMPOSIO_WEBHOOK_SECRET=

# ---- Models -----------------------------------------------------------------------------------
# Anthropic for answers. OpenAI is optional: it adds embeddings (semantic search) and is the
# fallback chat provider if no Anthropic key is set. Without OpenAI, search is full-text only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults: the fast and smart Claude models in the gateway).
NUGGET_MODEL_FAST=
NUGGET_MODEL_SMART=

# ---- Testing only: fake providers instead of Composio/Anthropic/OpenAI ------------------------
# Run `cargo run -p nugget-cloud --example fake_providers` with FAKE_PROVIDERS_BIND=0.0.0.0:9100
# on the Docker host and uncomment:
# COMPOSIO_BASE_URL=http://host.docker.internal:9100
# NUGGET_ANTHROPIC_BASE_URL=http://host.docker.internal:9100
# NUGGET_OPENAI_BASE_URL=http://host.docker.internal:9100

# ---- Optional -------------------------------------------------------------------------------
# Website origins allowed for CORS (comma-separated); empty = CORS off.
NUGGET_SITE_ORIGINS=
# Model-endpoint calls per minute per user (ghost text is chatty); default 120.
NUGGET_RATE_LLM_PER_MIN=120
# Website waitlist (POST /v1/waitlist): salt for stored IP hashes, and sign-ups per IP per hour.
# Harmless to leave unset on a self-hosted server.
NUGGET_WAITLIST_SALT=
NUGGET_RATE_WAITLIST_PER_HOUR=5
# Deep-link scheme for the app's hand-off pages.
NUGGET_APP_SCHEME=nugget
# json for log shippers; text otherwise.
NUGGET_LOG_FORMAT=text
# Use a copy of plans.toml with your own limits (mount it into the container).
# NUGGET_PLANS_FILE=/etc/heed/plans.toml
# Leave unset unless a trusted proxy in front of Caddy sets this header to the client's IP.
# NUGGET_CLIENT_IP_HEADER=
